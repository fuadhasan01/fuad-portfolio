---
// Accessible Accent Color Picker Island (Tania Rascia inspired)
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const accents = [
  { id: 'amber', name: 'Amber', colorLight: '#B26A34', colorDark: '#FEDE91' },
  { id: 'green', name: 'Green', colorLight: '#2B9476', colorDark: '#94D294' },
  { id: 'blue', name: 'Blue', colorLight: '#2A67A5', colorDark: '#6DB3F5' },
  { id: 'lavender', name: 'Lavender', colorLight: '#6A3EBA', colorDark: '#E5AAF5' },
  { id: 'rose', name: 'Rose', colorLight: '#B12D6C', colorDark: '#F2777A' }
];
---

<div class:list={["accent-picker inline-flex items-center", compact ? "gap-1" : "gap-1.5"]} role="group" aria-label="Accent color options">
  {accents.map((accent) => (
    <button
      type="button"
      data-accent-id={accent.id}
      class="accent-btn relative w-5 h-5 rounded-full border border-black/10 dark:border-white/20 transition-all duration-150 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-primary"
      style={`background-color: ${accent.colorLight};`}
      aria-label={`Set accent color to ${accent.name}`}
      title={accent.name}
    >
      <span class="sr-only">{accent.name}</span>
    </button>
  ))}
</div>

<style>
  :global(.dark) .accent-btn[data-accent-id="amber"] { background-color: #FEDE91 !important; }
  :global(.dark) .accent-btn[data-accent-id="green"] { background-color: #94D294 !important; }
  :global(.dark) .accent-btn[data-accent-id="blue"] { background-color: #6DB3F5 !important; }
  :global(.dark) .accent-btn[data-accent-id="lavender"] { background-color: #E5AAF5 !important; }
  :global(.dark) .accent-btn[data-accent-id="rose"] { background-color: #F2777A !important; }

  .accent-btn.active {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>

<script>
  function setupAccentPicker() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.accent-btn');
    if (!buttons.length) return;

    function syncActive(accentId: string) {
      buttons.forEach((btn) => {
        if (btn.getAttribute('data-accent-id') === accentId) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        }
      });
    }

    const currentAccent = document.documentElement.getAttribute('data-accent') || localStorage.getItem('accent') || 'amber';
    syncActive(currentAccent);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-accent-id') || 'amber';
        document.documentElement.setAttribute('data-accent', selected);
        try {
          localStorage.setItem('accent', selected);
        } catch (_) {}
        syncActive(selected);
      });
    });
  }

  setupAccentPicker();
  document.addEventListener('astro:after-swap', setupAccentPicker);
</script>
