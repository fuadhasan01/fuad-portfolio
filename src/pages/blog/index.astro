---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.published);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog & Engineering Notes | Fuad Hasan"
  description="Technical articles, architectural patterns, and production lessons on .NET, C#, Angular, and databases."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-12">
      <span class="text-xs font-semibold tracking-wider text-accent dark:text-accent-dark uppercase">
        TECHNICAL WRITING
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mt-2 mb-4">
        Blog & Engineering Notes
      </h1>
      <p class="text-lg text-muted dark:text-muted-dark leading-relaxed max-w-3xl">
        Practical guides, architectural patterns, and lessons from designing, building, and maintaining software systems.
      </p>
    </header>

    <!-- Articles List / Grid -->
    {
      sortedPosts.length === 0 ? (
        <div class="text-center py-16 border border-border dark:border-border-dark rounded-2xl bg-surface-light dark:bg-surface-dark">
          <p class="text-lg font-medium text-muted dark:text-muted-dark">No published articles yet.</p>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Check back soon for new technical writing.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article class="flex flex-col justify-between p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-all hover:shadow-md">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-accent dark:text-accent-dark mb-4">
                  {post.data.category}
                </span>
                <h2 class="text-xl font-bold text-primary dark:text-primary-dark mb-2">
                  <a href={`/blog/${post.id}`} class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-3 mb-4">
                  {post.data.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-border dark:border-border-dark flex items-center justify-between text-xs text-muted dark:text-muted-dark">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <a href={`/blog/${post.id}`} class="font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded">
                  Read article &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

