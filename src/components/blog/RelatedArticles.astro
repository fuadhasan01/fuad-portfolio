---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  currentSlug: string;
  category: string;
  tags: string[];
  posts: CollectionEntry<'blog'>[];
}

const { currentSlug, category, tags, posts } = Astro.props;

// Filter out current article and find related articles
const related = posts
  .filter((p) => p.id !== currentSlug)
  .map((p) => {
    let score = 0;
    if (p.data.category === category) score += 2;
    const tagMatches = p.data.tags.filter((t) => tags.includes(t)).length;
    score += tagMatches;
    return { post: p, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 2)
  .map((item) => item.post);
---

{
  related.length > 0 && (
    <div class="mt-8 p-6 rounded-2xl border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm">
      <h3 class="text-xs font-mono tracking-widest text-accent dark:text-accent-dark uppercase mb-4 flex items-center gap-2 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent-dark"></span>
        Related Reading
      </h3>
      <div class="space-y-5">
        {related.map((post) => {
          const rt = getReadingTime(post.body || '');
          return (
            <div class="group border-b border-border/50 dark:border-border-dark/50 pb-4 last:border-b-0 last:pb-0">
              <span class="text-[11px] font-mono uppercase tracking-wider text-accent dark:text-accent-dark block mb-1">
                {post.data.category}
              </span>
              <a
                href={`/blog/${post.id}`}
                class="font-serif text-base font-normal text-primary dark:text-primary-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors line-clamp-2 block mb-1.5 focus-ring rounded leading-snug"
              >
                {post.data.title}
              </a>
              <span class="text-xs font-mono text-muted dark:text-muted-dark">
                {rt.text}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  )
}
