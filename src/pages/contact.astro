---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import SocialIcon from '../components/common/SocialIcon.astro';
---

<BaseLayout
  title="Contact | Fuad Hasan"
  description="Get in touch with Fuad Hasan for full-stack engineering opportunities, architecture consulting, and professional collaboration."
>
  <div>
    <!-- Header -->
    <header class="mb-10">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-heading mb-2.5">
        Get in Touch
      </h1>
      <p class="text-sm sm:text-base font-sans text-muted leading-relaxed max-w-2xl">
        I am open to full-time software engineering roles, technical architecture collaborations, and distributed systems discussions.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <!-- Direct Email Card -->
      <div class="p-6 rounded-lg bg-surface border border-border-card flex flex-col justify-between shadow-sm">
        <div>
          <div class="w-9 h-9 rounded-md border border-border bg-alt text-accent flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="font-heading text-xl font-bold text-heading mb-1.5">
            Direct Email
          </h2>
          <p class="text-sm font-sans text-muted leading-relaxed mb-6">
            The fastest way to reach me for job opportunities, architectural discussions, or technical project reviews.
          </p>
        </div>

        <div>
          <a
            id="email-cta-link"
            href="mailto:contact@fuadhasan.dev"
            class="btn-primary w-full text-center"
          >
            Send Email (mailto) &rarr;
          </a>
          <button
            id="copy-email-button"
            type="button"
            class="mt-2.5 btn-secondary w-full text-center"
          >
            Copy Email Address
          </button>
          <p id="copy-email-status" class="text-xs font-mono text-center text-accent mt-2 hidden" role="status" aria-live="polite">
            Email address copied to clipboard!
          </p>
        </div>
      </div>

      <!-- Professional Profiles Card -->
      <div class="p-6 rounded-lg bg-surface border border-border-card flex flex-col justify-between shadow-sm">
        <div>
          <div class="w-9 h-9 rounded-md border border-border bg-alt text-accent flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h2 class="font-heading text-xl font-bold text-heading mb-1.5">
            Engineering Profiles
          </h2>
          <p class="text-sm font-sans text-muted leading-relaxed mb-6">
            Inspect my open-source code repositories, competitive programming track record, and verified professional network.
          </p>
        </div>

        <ul class="space-y-2" role="list">
          {
            profile.socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-2.5 rounded-md border border-border bg-subtle/40 hover:border-accent hover:bg-alt transition-colors focus-ring"
                >
                  <div class="flex items-center gap-2.5">
                    <SocialIcon name={social.icon || social.name} class="w-4 h-4 text-accent" />
                    <span class="text-xs font-mono text-heading font-medium">{social.name}</span>
                  </div>
                  <span class="text-xs text-muted font-mono">&nearr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Resume Access & Privacy Safe Handling -->
    <section class="p-6 rounded-lg bg-surface border border-border-card shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div>
          <h2 class="font-heading text-xl font-bold text-heading mb-1">Download Résumé</h2>
          <p class="text-sm font-sans text-muted leading-relaxed max-w-xl">
            A comprehensive overview of my software engineering experience, education, and technical stack. Sanitized for public download to protect personal phone and residential address privacy.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a
            href={profile.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Download CV &nearr;
          </a>
        </div>
      </div>
    </section>

    <!-- Privacy Note -->
    <div class="mt-6 text-center text-xs font-mono text-muted">
      <p>
        Privacy notice: Personal phone number and residential address are intentionally withheld from public display in compliance with personal privacy standards.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  function setupContactPage() {
    const copyBtn = document.getElementById('copy-email-button');
    const status = document.getElementById('copy-email-status');
    const emailLink = document.getElementById('email-cta-link') as HTMLAnchorElement | null;

    if (!copyBtn || !status) return;

    copyBtn.addEventListener('click', async () => {
      const email = emailLink?.getAttribute('href')?.replace('mailto:', '') || 'contact@fuadhasan.dev';
      try {
        await navigator.clipboard.writeText(email);
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 3500);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }

  setupContactPage();
  document.addEventListener('astro:after-swap', setupContactPage);
</script>
