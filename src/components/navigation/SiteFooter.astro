---
import { profile } from '../../data/profile';
import SocialLinks from '../common/SocialLinks.astro';
---

<footer
  class="mt-auto border-t border-border py-8 px-5 sm:px-8 lg:px-10 w-full transition-colors"
  role="contentinfo"
>
  <div class="max-w-content-wide mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-muted">
    <div class="flex items-center gap-2">
      <span class="font-heading font-semibold text-heading">{profile.name}</span>
      <span aria-hidden="true">•</span>
      <span class="font-mono">&copy; {new Date().getFullYear()}</span>
    </div>

    <p class="font-mono text-center md:text-left">
      Systems &amp; Full Stack Software Engineer
    </p>

    <div class="flex items-center gap-4">
      <SocialLinks size="sm" includeEmail={false} includeRss={true} />
      <span aria-hidden="true" class="text-border">•</span>
      <a
        href="#main-content"
        class="text-xs font-mono text-muted hover:text-accent transition-colors"
        aria-label="Back to top"
      >
        Top &uarr;
      </a>
    </div>
  </div>
</footer>
