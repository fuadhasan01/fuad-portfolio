---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { skillCategories } from '../data/skills';
import ButtonLink from '../components/common/ButtonLink.astro';
---

<BaseLayout
  title="About | Fuad Hasan"
  description="Background, engineering principles, education, and technical expertise of Fuad Hasan, Full Stack Software Engineer."
>
  <div class="max-w-4xl mx-auto px-6 md:px-8 py-12 lg:py-16">
    <!-- Header with Architectural Portrait Frame -->
    <header class="mb-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
        <!-- Portrait Image Space (Clean framing, no floating pill, no glow) -->
        <div class="md:col-span-5 max-w-xs w-full mx-auto md:mx-0">
          <div class="aspect-[4/5] rounded-lg overflow-hidden border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm">
            <img
              src={profile.avatarUrl}
              alt="Portrait of Fuad Hasan"
              width="480"
              height="600"
              class="w-full h-full object-cover object-center grayscale contrast-105 hover:grayscale-0 transition-all duration-300"
              loading="eager"
            />
          </div>
          <div class="mt-2.5 flex items-center justify-between text-[11px] font-mono text-muted dark:text-muted-dark px-1">
            <span>FUAD HASAN</span>
            <span>DHAKA, BANGLADESH</span>
          </div>
        </div>

        <!-- Narrative Column -->
        <div class="md:col-span-7">
          <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mb-4 leading-tight">
            About Me
          </h1>
          <p class="text-lg text-muted dark:text-muted-dark leading-relaxed font-sans mb-6">
            Full Stack Software Engineer based in Dhaka, Bangladesh, with a strong focus on high-reliability backend systems, database performance, and clean domain architecture.
          </p>
          <div class="space-y-1.5 text-xs font-mono text-muted dark:text-muted-dark border-t border-border dark:border-border-dark pt-4">
            <p><span class="text-primary dark:text-primary-dark font-medium">Current Role:</span> Lead Engineer at Efficient Software Solutions LTD</p>
            <p><span class="text-primary dark:text-primary-dark font-medium">Education:</span> BSc in CSE • UIU (Summa / Honors)</p>
            <p><span class="text-accent dark:text-accent-dark font-medium">Availability:</span> Open for select engineering roles</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Engineering Philosophy -->
    <section class="mb-16 border-t border-border dark:border-border-dark pt-12" aria-labelledby="philosophy-heading">
      <h2 id="philosophy-heading" class="font-display text-2xl sm:text-3xl font-bold text-primary dark:text-primary-dark mb-6">
        Engineering Philosophy
      </h2>
      <div class="space-y-4 text-base text-muted dark:text-muted-dark leading-relaxed font-sans">
        <p>
          I approach software engineering with a strong focus on system dependability and domain clarity. My core experience centers on modern C# and ASP.NET Core, where I prioritize clean architecture boundaries, robust transactional consistency, and predictable API contracts.
        </p>
        <p>
          In distributed and enterprise environments, I use patterns like the Transactional Outbox and asynchronous messaging with MassTransit and RabbitMQ to eliminate dual-write vulnerabilities and maintain reliability under network failure. When working with databases—whether PostgreSQL or Microsoft SQL Server—I focus on thoughtful indexing, query execution plan profiling, and eliminating N+1 bottlenecks.
        </p>
        <p>
          On the frontend, I develop structured, reactive user interfaces with Angular and TypeScript, keeping code modular, strictly typed, and aligned with backend contracts.
        </p>
      </div>
    </section>

    <!-- Technical Skills -->
    <section class="mb-16 border-t border-border dark:border-border-dark pt-12" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="font-display text-2xl sm:text-3xl font-bold text-primary dark:text-primary-dark mb-2">
        Technical Expertise
      </h2>
      <p class="text-sm font-sans text-muted dark:text-muted-dark mb-8">
        Core technologies and architectural paradigms applied across enterprise systems and production projects.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {skillCategories.map((cat) => (
          <div class="p-6 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
            <h3 class="font-display text-base font-bold text-primary dark:text-primary-dark mb-3">
              {cat.title}
            </h3>
            <p class="text-xs font-mono text-muted dark:text-muted-dark leading-relaxed">
              {cat.skills.join(' • ')}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education & Achievements -->
    <section class="mb-16 border-t border-border dark:border-border-dark pt-12" aria-labelledby="education-heading">
      <h2 id="education-heading" class="font-display text-2xl sm:text-3xl font-bold text-primary dark:text-primary-dark mb-6">
        Education &amp; Academic Honors
      </h2>

      <div class="space-y-6">
        <!-- Degree -->
        <div class="p-6 sm:p-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h3 class="font-display text-xl font-bold text-primary dark:text-primary-dark">
              United International University (UIU)
            </h3>
            <span class="text-xs font-mono text-muted dark:text-muted-dark">2020 – 2024</span>
          </div>
          <p class="text-sm font-semibold text-accent dark:text-accent-dark mb-2">
            Bachelor of Science in Computer Science and Engineering (BSc in CSE)
          </p>
          <p class="text-sm text-muted dark:text-muted-dark font-sans">
            Graduated with a CGPA of <strong class="text-primary dark:text-primary-dark">3.6 / 4.0</strong>, with a major concentration in Software Engineering.
          </p>
        </div>

        <!-- Recognition -->
        <div class="p-6 sm:p-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
          <h3 class="font-display text-xl font-bold text-primary dark:text-primary-dark mb-4">
            Honors &amp; Achievements
          </h3>
          <ul class="space-y-3 text-sm text-muted dark:text-muted-dark font-sans">
            <li class="flex items-start gap-2.5">
              <span class="text-accent dark:text-accent-dark font-mono text-base">•</span>
              <span><strong class="text-primary dark:text-primary-dark">UIU Project Show Champion:</strong> Awarded champion for the ArtPatio project (digital art gallery web platform).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-accent dark:text-accent-dark font-mono text-base">•</span>
              <span><strong class="text-primary dark:text-primary-dark">UIU Merit Scholarship:</strong> Awarded across 7 academic trimesters based on academic standing.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-accent dark:text-accent-dark font-mono text-base">•</span>
              <span><strong class="text-primary dark:text-primary-dark">Competitive Problem Solving:</strong> Solved 500+ algorithmic challenges across competitive programming platforms.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Navigation Next -->
    <div class="border-t border-border dark:border-border-dark pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <ButtonLink href="/experience" variant="primary">
        View Career Experience &rarr;
      </ButtonLink>
      <ButtonLink href="/projects" variant="outline">
        Explore Case Studies &rarr;
      </ButtonLink>
    </div>
  </div>
</BaseLayout>
