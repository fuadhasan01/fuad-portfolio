---
import { siteSettings } from '../../data/siteSettings';
import { profile } from '../../data/profile';
import { buildCanonicalUrl, buildSocialImageUrl } from '../../utils/seo';

export interface ArticleData {
  headline: string;
  description: string;
  datePublished: Date;
  dateModified?: Date;
  image?: string;
  authorName?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  articleData?: ArticleData;
}

const {
  title = siteSettings.defaultTitle,
  description = siteSettings.defaultDescription,
  image,
  article = false,
  articleData
} = Astro.props;

const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const socialImageUrl = buildSocialImageUrl(image);

// Build Schema.org Structured Data (FR-029)
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteSettings.siteUrl}/#website`,
      url: `${siteSettings.siteUrl}/`,
      name: siteSettings.siteName,
      description: siteSettings.defaultDescription,
      inLanguage: 'en-US',
      publisher: {
        '@id': `${siteSettings.siteUrl}/#person`
      }
    },
    {
      '@type': 'Person',
      '@id': `${siteSettings.siteUrl}/#person`,
      name: profile.name,
      jobTitle: profile.title,
      url: `${siteSettings.siteUrl}/`,
      sameAs: profile.socialLinks.map((s) => s.url),
      knowsAbout: [
        'C#',
        'ASP.NET Core',
        '.NET 9',
        'Entity Framework Core',
        'Angular',
        'PostgreSQL',
        'Microsoft SQL Server',
        'CQRS',
        'Domain-Driven Design',
        'Distributed Systems'
      ]
    }
  ]
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: articleData?.headline || title,
      description: articleData?.description || description,
      datePublished: (articleData?.datePublished || new Date()).toISOString(),
      dateModified: (articleData?.dateModified || articleData?.datePublished || new Date()).toISOString(),
      image: buildSocialImageUrl(articleData?.image || image),
      author: {
        '@type': 'Person',
        name: profile.name,
        url: siteSettings.siteUrl
      },
      publisher: {
        '@type': 'Person',
        name: profile.name
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      }
    }
  : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Favicons & Touch Icons (FR-027) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalUrl} />

<!-- Web Fonts: Cabinet Grotesk (Display), DM Sans (Body), JetBrains Mono (Technical) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800,900&display=swap"
  rel="stylesheet"
/>
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
  rel="stylesheet"
/>

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={siteSettings.author} />

<!-- OpenGraph / Facebook (FR-027) -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:site_name" content={siteSettings.siteName} />

<!-- Twitter (FR-027) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />

<!-- RSS Feed Auto-discovery (FR-025) -->
<link rel="alternate" type="application/rss+xml" title={siteSettings.siteName} href="/rss.xml" />

<!-- Structured Data JSON-LD (FR-029, TC-014) -->
<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

<!-- Zero-flash theme initialization script (Default: Dark Mode) -->
<script is:inline>
  (function() {
    try {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    } catch (_) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>

<!-- Privacy-Minded Outbound Link Measurement (FR-030, FR-031) -->
<script is:inline>
  (function() {
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (!link) return;
      const href = link.getAttribute('href');
      if (href && (href.startsWith('http://') || href.startsWith('https://')) && !href.includes(window.location.hostname)) {
        try {
          const url = new URL(href);
          // Dispatch custom event for privacy-minded observation
          window.dispatchEvent(new CustomEvent('portfolio:outbound-click', {
            detail: { destination: url.hostname, pathname: url.pathname }
          }));
        } catch (_) {}
      }
    });
  })();
</script>
