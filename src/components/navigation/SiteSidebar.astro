---
import { profile } from '../../data/profile';
import { mainNavigation } from '../../data/navigation';
import ThemeToggle from '../common/ThemeToggle.astro';
import AccentPicker from '../common/AccentPicker.astro';
import SocialIcon from '../common/SocialIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<aside
  class="hidden lg:flex flex-col w-[260px] min-w-[260px] h-screen sticky top-0 overflow-y-auto border-r border-border bg-canvas px-6 py-7 text-sm shrink-0 z-30 transition-colors"
  aria-label="Site Sidebar"
>
  <!-- Identity & Avatar -->
  <div class="mb-6">
    <a href="/" class="group block focus-ring rounded-lg">
      <img
        src={profile.avatarUrl}
        alt="Fuad Hasan"
        width="56"
        height="56"
        class="w-14 h-14 rounded-lg object-cover border border-border group-hover:border-accent transition-colors mb-3"
      />
      <span class="block font-heading font-bold text-lg text-heading group-hover:text-accent transition-colors leading-snug">
        {profile.name}
      </span>
    </a>
    <p class="text-xs font-medium text-muted mt-0.5">
      {profile.title}
    </p>
    <p class="text-xs text-muted mt-2.5 leading-relaxed">
      Building resilient systems with C#, ASP.NET Core, Angular, and SQL Server.
    </p>
  </div>

  <!-- Primary Navigation -->
  <nav class="flex flex-col gap-1 py-4 border-t border-border" aria-label="Main Navigation">
    {mainNavigation.map((item) => {
      const isActive =
        item.href === '/'
          ? currentPath === '/'
          : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
      return (
        <a
          href={item.href}
          class:list={[
            'flex items-center px-3 py-1.5 rounded-md font-medium text-sm transition-colors focus-ring',
            isActive
              ? 'bg-alt text-accent font-semibold'
              : 'text-body hover:bg-alt hover:text-heading'
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </nav>

  <!-- Connect & Social Channels -->
  <div class="py-4 border-t border-border">
    <h2 class="text-xs font-mono uppercase tracking-wider text-muted mb-2.5">
      Connect
    </h2>
    <div class="flex flex-col gap-1.5">
      {profile.socialLinks.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2.5 px-3 py-1.5 rounded-md text-xs font-medium text-muted hover:text-heading hover:bg-alt transition-colors focus-ring"
          aria-label={`${social.name} profile of Fuad Hasan (opens in new tab)`}
        >
          <SocialIcon name={social.icon || social.name} class="w-4 h-4 shrink-0" />
          <span>{social.name}</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      ))}
      <a
        href={`mailto:${profile.email}`}
        class="flex items-center gap-2.5 px-3 py-1.5 rounded-md text-xs font-medium text-muted hover:text-heading hover:bg-alt transition-colors focus-ring"
        aria-label="Send email to Fuad Hasan"
      >
        <SocialIcon name="email" class="w-4 h-4 shrink-0" />
        <span>Email</span>
      </a>
      <a
        href={profile.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-3 py-1.5 rounded-md text-xs font-medium text-accent hover:underline focus-ring mt-1"
        aria-label="Download Fuad Hasan's Résumé PDF (opens in new tab)"
      >
        <SocialIcon name="rss" class="w-4 h-4 shrink-0 opacity-0" aria-hidden="true" />
        <span class="font-semibold">Résumé PDF &nearr;</span>
      </a>
    </div>
  </div>

  <!-- Sidebar Footer: Theme & Accent Controls -->
  <div class="mt-auto pt-4 border-t border-border flex flex-col gap-3">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-muted">Theme</span>
      <ThemeToggle />
    </div>
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-muted">Accent</span>
      <AccentPicker />
    </div>
  </div>
</aside>
