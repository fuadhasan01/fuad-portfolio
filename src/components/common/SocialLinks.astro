---
import { profile } from '../../data/profile';
import SocialIcon from './SocialIcon.astro';

interface Props {
  includeEmail?: boolean;
  includeRss?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  includeEmail = true,
  includeRss = false,
  size = 'md',
  class: className = ''
} = Astro.props;

const sizeClasses = {
  sm: 'w-9 h-9',
  md: 'w-10 h-10',
  lg: 'w-11 h-11'
};

const iconSizes = {
  sm: 'w-4 h-4',
  md: 'w-4 h-4',
  lg: 'w-5 h-5'
};
---

<div class:list={['flex items-center gap-2.5', className]}>
  {profile.socialLinks.map((social) => (
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        sizeClasses[size],
        'rounded-lg border border-border dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark hover:bg-surface-light dark:hover:bg-surface-dark transition-all duration-200 focus-ring'
      ]}
      aria-label={`${social.name} profile of Fuad Hasan (opens in new tab)`}
      title={social.name}
    >
      <SocialIcon name={social.icon || social.name} class={iconSizes[size]} />
      <span class="sr-only">{social.name}</span>
    </a>
  ))}

  {includeEmail && (
    <a
      href={`mailto:${profile.email}`}
      class:list={[
        sizeClasses[size],
        'rounded-lg border border-border dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark hover:bg-surface-light dark:hover:bg-surface-dark transition-all duration-200 focus-ring'
      ]}
      aria-label="Send email to Fuad Hasan"
      title="Direct Email"
    >
      <SocialIcon name="email" class={iconSizes[size]} />
      <span class="sr-only">Email</span>
    </a>
  )}

  {includeRss && (
    <a
      href="/rss.xml"
      class:list={[
        sizeClasses[size],
        'rounded-lg border border-border dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark hover:bg-surface-light dark:hover:bg-surface-dark transition-all duration-200 focus-ring'
      ]}
      aria-label="RSS Feed for Technical Blog"
      title="RSS Feed"
    >
      <SocialIcon name="rss" class={iconSizes[size]} />
      <span class="sr-only">RSS Feed</span>
    </a>
  )}
</div>
