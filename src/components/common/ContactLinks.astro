---
import { profile } from '../../data/profile';
import SocialIcon from './SocialIcon.astro';

interface Props {
  showEmailDirect?: boolean;
}

const { showEmailDirect = true } = Astro.props;
---

<div class="space-y-4">
  {showEmailDirect && (
    <div class="p-6 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
      <h3 class="text-lg font-display font-bold text-primary dark:text-primary-dark mb-2">Direct Email</h3>
      <p class="text-sm text-muted dark:text-muted-dark mb-4">
        Reach out directly for full-stack engineering roles, technical architecture, or consulting.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          id="contact-email-link"
          href="mailto:contact@fuadhasan.dev"
          class="inline-flex items-center justify-center px-4 py-2.5 text-xs font-mono uppercase tracking-wider font-semibold rounded bg-accent dark:bg-accent-dark text-white dark:text-canvas-dark hover:opacity-95 transition-opacity focus-ring"
        >
          Send Email &rarr;
        </a>
        <button
          id="contact-copy-email-btn"
          type="button"
          class="inline-flex items-center justify-center px-4 py-2.5 text-xs font-mono uppercase tracking-wider font-medium rounded border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-accent dark:hover:border-accent-dark transition-colors focus-ring"
        >
          Copy Email Address
        </button>
      </div>
      <p id="contact-copy-status" class="text-xs font-mono text-accent dark:text-accent-dark mt-2 hidden" role="status" aria-live="polite">
        Email address copied to clipboard!
      </p>
    </div>
  )}

  <div class="p-6 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
    <h3 class="text-lg font-display font-bold text-primary dark:text-primary-dark mb-2">Public Engineering Channels</h3>
    <p class="text-sm text-muted dark:text-muted-dark mb-4">
      Inspect open-source repositories, problem-solving profiles, and professional network.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {profile.socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3 rounded border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark hover:bg-secondary-light/40 dark:hover:bg-secondary-dark/40 transition-colors focus-ring"
        >
          <div class="flex items-center gap-2.5">
            <SocialIcon name={link.icon || link.name} class="w-4 h-4 text-muted dark:text-muted-dark" />
            <span class="text-xs font-mono font-medium text-primary dark:text-primary-dark">{link.name}</span>
          </div>
          <span class="text-xs text-muted dark:text-muted-dark font-mono">&nearr;</span>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  function setupContactCopy() {
    const copyBtn = document.getElementById('contact-copy-email-btn');
    const status = document.getElementById('contact-copy-status');
    const emailLink = document.getElementById('contact-email-link') as HTMLAnchorElement | null;

    if (!copyBtn || !status) return;

    copyBtn.addEventListener('click', async () => {
      const email = emailLink?.getAttribute('href')?.replace('mailto:', '') || 'contact@fuadhasan.dev';
      try {
        await navigator.clipboard.writeText(email);
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 3000);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }

  setupContactCopy();
  document.addEventListener('astro:after-swap', setupContactCopy);
</script>

