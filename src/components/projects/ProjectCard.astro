---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  category,
  technologies,
  cover,
  coverAlt,
  repositoryUrl,
  demoUrl,
  timeline
} = project.data;
---

<article
  class="flex flex-col justify-between border border-border-card bg-surface hover:border-accent transition-colors rounded-lg overflow-hidden group shadow-sm"
  data-category={category}
  data-technologies={technologies.join(',')}
  data-project-card
>
  <div>
    <!-- Project Thumbnail / Diagram -->
    <a
      href={`/projects/${project.id}`}
      class="block aspect-[16/10] overflow-hidden bg-alt border-b border-border focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={cover}
        alt={coverAlt}
        width="600"
        height="375"
        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </a>

    <div class="p-5 sm:p-6">
      <!-- Category & Timeline Meta -->
      <div class="flex items-center justify-between text-xs font-mono text-muted mb-2.5">
        <span class="text-accent font-medium uppercase tracking-wider">{category}</span>
        <span>{timeline || '2024'}</span>
      </div>

      <!-- Title -->
      <h3 class="text-lg sm:text-xl font-heading font-bold text-heading mb-2">
        <a
          href={`/projects/${project.id}`}
          class="hover:text-accent focus-ring rounded inline-block"
        >
          {title}
        </a>
      </h3>

      <!-- Summary -->
      <p class="text-sm text-muted leading-relaxed line-clamp-3 mb-4 font-sans">
        {summary}
      </p>

      <!-- Technology Tags (Tania chip style) -->
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border">
        {technologies.slice(0, 4).map((tech) => (
          <span class="chip-tag text-[11px] py-0.5 px-2">
            {tech}
          </span>
        ))}
        {technologies.length > 4 && (
          <span class="text-xs font-mono text-muted self-center ml-1">
            +{technologies.length - 4}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Action Links Footer -->
  <div class="px-5 sm:px-6 py-3 border-t border-border flex items-center justify-between font-mono text-xs bg-subtle/30">
    <a
      href={`/projects/${project.id}`}
      class="text-accent font-medium hover:underline focus-ring"
      aria-label={`Case Study: ${title}`}
    >
      <span>Case Study</span> <span aria-hidden="true">&rarr;</span>
    </a>

    <div class="flex items-center space-x-3 text-xs">
      {repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-heading transition-colors focus-ring"
          aria-label={`Source: ${title} on GitHub (opens in new tab)`}
        >
          <span>Source</span> <span aria-hidden="true">&nearr;</span>
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-heading transition-colors focus-ring"
          aria-label={`Demo: ${title} live demonstration (opens in new tab)`}
        >
          <span>Demo</span> <span aria-hidden="true">&nearr;</span>
        </a>
      )}
    </div>
  </div>
</article>
