---
import { profile } from '../../data/profile';
import { mainNavigation } from '../../data/navigation';
import ThemeToggle from '../common/ThemeToggle.astro';
import AccentPicker from '../common/AccentPicker.astro';
import SocialIcon from '../common/SocialIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header
  class="lg:hidden sticky top-0 z-40 w-full bg-canvas/95 backdrop-blur border-b border-border transition-colors"
  role="banner"
>
  <div class="h-14 px-4 sm:px-6 flex items-center justify-between">
    <!-- Brand / Monogram & Name -->
    <a href="/" class="flex items-center gap-2.5 font-heading font-bold text-base text-heading hover:text-accent transition-colors focus-ring">
      <img
        src={profile.avatarUrl}
        alt="Fuad Hasan"
        width="28"
        height="28"
        class="w-7 h-7 rounded-md object-cover border border-border"
      />
      <span>{profile.name}</span>
    </a>

    <!-- Right Header Controls -->
    <div class="flex items-center gap-2">
      <AccentPicker />
      <ThemeToggle id="theme-toggle-mobile" />

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-trigger"
        type="button"
        class="inline-flex items-center justify-center p-2 rounded-md text-muted hover:text-heading hover:bg-alt transition-colors focus-ring"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Disclosure Menu Panel -->
  <nav
    id="mobile-menu-panel"
    class="hidden lg:hidden border-t border-border px-5 py-4 bg-canvas shadow-lg flex flex-col gap-1 transition-all"
    aria-label="Mobile Navigation"
  >
    {mainNavigation.map((item) => {
      const isActive =
        item.href === '/'
          ? currentPath === '/'
          : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
      return (
        <a
          href={item.href}
          class:list={[
            'px-3 py-2 rounded-md font-medium text-sm transition-colors focus-ring',
            isActive ? 'bg-alt text-accent font-semibold' : 'text-body hover:bg-alt hover:text-heading'
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })}

    <div class="pt-3 mt-2 border-t border-border flex flex-wrap items-center gap-3">
      {profile.socialLinks.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-md border border-border text-muted hover:text-accent hover:border-accent transition-colors focus-ring"
          aria-label={`${social.name} profile of Fuad Hasan (opens in new tab)`}
        >
          <SocialIcon name={social.icon || social.name} class="w-4 h-4" />
        </a>
      ))}
      <a
        href={`mailto:${profile.email}`}
        class="p-2 rounded-md border border-border text-muted hover:text-accent hover:border-accent transition-colors focus-ring"
        aria-label="Send email to Fuad Hasan"
      >
        <SocialIcon name="email" class="w-4 h-4" />
      </a>
      <a
        href={profile.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto text-xs font-semibold text-accent hover:underline focus-ring px-2 py-1"
        aria-label="Download Fuad Hasan's Résumé PDF (opens in new tab)"
      >
        Résumé PDF &nearr;
      </a>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-menu-panel');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!trigger || !panel || !iconOpen || !iconClose) return;

    const navTrigger = trigger;
    const navPanel = panel;
    const navIconOpen = iconOpen;
    const navIconClose = iconClose;

    const toggleMenu = (isOpen: boolean) => {
      navTrigger.setAttribute('aria-expanded', String(isOpen));
      navTrigger.setAttribute('aria-label', isOpen ? 'Close mobile navigation menu' : 'Open mobile navigation menu');
      if (isOpen) {
        navPanel.classList.remove('hidden');
        navIconOpen.classList.add('hidden');
        navIconClose.classList.remove('hidden');
      } else {
        navPanel.classList.add('hidden');
        navIconOpen.classList.remove('hidden');
        navIconClose.classList.add('hidden');
      }
    };

    navTrigger.addEventListener('click', () => {
      const isExpanded = navTrigger.getAttribute('aria-expanded') === 'true';
      toggleMenu(!isExpanded);
    });

    // Close on navigation click
    navPanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navTrigger.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        navTrigger.focus();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
