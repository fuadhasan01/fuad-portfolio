---
import { profile } from '../../data/profile';
import SocialIcon from './SocialIcon.astro';

interface Props {
  showEmailDirect?: boolean;
}

const { showEmailDirect = true } = Astro.props;
---

<div class="space-y-4">
  {showEmailDirect && (
    <div class="p-6 rounded-lg bg-surface border border-border-card">
      <h3 class="text-lg font-heading font-bold text-heading mb-2">Direct Email</h3>
      <p class="text-sm text-muted mb-4 font-sans">
        Reach out directly for full-stack engineering roles, technical architecture, or consulting.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          id="contact-email-link"
          href="mailto:contact@fuadhasan.dev"
          class="btn-primary"
        >
          Send Email &rarr;
        </a>
        <button
          id="contact-copy-email-btn"
          type="button"
          class="btn-secondary"
        >
          Copy Email Address
        </button>
      </div>
      <p id="contact-copy-status" class="text-xs font-mono text-accent mt-2 hidden" role="status" aria-live="polite">
        Email address copied to clipboard!
      </p>
    </div>
  )}

  <div class="p-6 rounded-lg bg-surface border border-border-card">
    <h3 class="text-lg font-heading font-bold text-heading mb-2">Public Engineering Channels</h3>
    <p class="text-sm text-muted mb-4 font-sans">
      Inspect open-source repositories, problem-solving profiles, and professional network.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {profile.socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-3 rounded-lg border border-border bg-subtle/50 hover:border-accent hover:bg-alt transition-colors focus-ring"
          aria-label={`${link.name} profile of Fuad Hasan (opens in new tab)`}
        >
          <SocialIcon name={link.icon || link.name} class="w-5 h-5 text-accent shrink-0" />
          <div>
            <p class="text-xs font-semibold text-heading">{link.name}</p>
            <p class="text-[11px] font-mono text-muted">Profile &nearr;</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  function setupContactCopy() {
    const copyBtn = document.getElementById('contact-copy-email-btn');
    const statusText = document.getElementById('contact-copy-status');

    if (!copyBtn || !statusText) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('contact@fuadhasan.dev');
        statusText.classList.remove('hidden');
        setTimeout(() => {
          statusText.classList.add('hidden');
        }, 3000);
      } catch (err) {
        // Fallback for environments where clipboard API is unavailable
        const temp = document.createElement('textarea');
        temp.value = 'contact@fuadhasan.dev';
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        statusText.classList.remove('hidden');
        setTimeout(() => {
          statusText.classList.add('hidden');
        }, 3000);
      }
    });
  }

  setupContactCopy();
  document.addEventListener('astro:after-swap', setupContactCopy);
</script>
