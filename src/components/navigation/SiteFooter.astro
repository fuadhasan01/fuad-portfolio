---
import { profile } from '../../data/profile';
import SocialLinks from '../common/SocialLinks.astro';
---

<footer class="mt-auto border-t border-border dark:border-border-dark py-12 px-6 md:px-12 max-w-6xl mx-auto w-full flex flex-col sm:flex-row items-center justify-between gap-6 transition-colors" role="contentinfo">
  <div class="flex items-center gap-3 text-xs text-muted dark:text-muted-dark">
    <span class="font-display font-semibold text-primary dark:text-primary-dark">{profile.name}</span>
    <span aria-hidden="true" class="text-border dark:text-border-dark">•</span>
    <span class="font-mono">&copy; {new Date().getFullYear()}</span>
  </div>

  <p class="text-xs text-muted dark:text-muted-dark text-center font-mono">
    Architectural systems. Verified implementations.
  </p>

  <SocialLinks size="sm" includeEmail={false} includeRss={true} />
</footer>
