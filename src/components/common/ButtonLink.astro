---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  external?: boolean;
  class?: string;
  download?: boolean | string;
}

const {
  href,
  variant = 'primary',
  external = false,
  class: className = '',
  download
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium text-sm px-4 py-2 rounded-lg transition-all focus-ring gap-1.5';

const variantStyles = {
  primary: 'border-[1.5px] border-accent text-accent hover:bg-accent hover:text-[#16161A] font-semibold bg-transparent',
  secondary: 'bg-subtle border border-border text-body hover:border-strong hover:text-heading hover:bg-alt',
  outline: 'border border-border text-body hover:border-accent hover:text-accent bg-transparent'
};
---

<a
  href={href}
  class:list={[baseStyles, variantStyles[variant], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? (typeof download === 'string' ? download : true) : undefined}
>
  <slot />
</a>
