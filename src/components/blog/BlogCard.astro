---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article
  class="flex flex-col justify-between rounded-lg bg-surface border border-border-card hover:border-accent transition-colors group h-full overflow-hidden shadow-sm"
  data-blog-card
  data-category={post.data.category}
  data-title={post.data.title.toLowerCase()}
  data-excerpt={post.data.excerpt.toLowerCase()}
  data-tags={post.data.tags.join(',').toLowerCase()}
>
  <div>
    <!-- Cover Image Thumbnail -->
    <a
      href={`/blog/${post.id}`}
      class="block aspect-[16/9] overflow-hidden bg-alt border-b border-border focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={post.data.cover}
        alt={post.data.coverAlt}
        width="600"
        height="338"
        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </a>

    <div class="p-5 sm:p-6">
      <!-- Category & Reading Time -->
      <div class="flex items-center justify-between gap-2 mb-2.5 text-xs font-mono">
        <span class="text-accent font-medium uppercase tracking-wider">
          {post.data.category}
        </span>
        <span class="text-muted">
          {readingTime.text}
        </span>
      </div>

      <!-- Article Title -->
      <h3 class="font-heading text-lg sm:text-xl font-bold text-heading mb-2 leading-snug">
        <a href={`/blog/${post.id}`} class="hover:text-accent focus-ring rounded">
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-muted leading-relaxed line-clamp-3 mb-4 font-sans">
        {post.data.excerpt}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border">
        {post.data.tags.map((tag) => (
          <span class="chip-tag text-[11px] py-0.5 px-2">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="px-5 sm:px-6 py-3 border-t border-border flex items-center justify-between text-xs font-mono bg-subtle/30">
    <time datetime={post.data.pubDate.toISOString()} class="text-muted">
      {formattedDate}
    </time>
    <a
      href={`/blog/${post.id}`}
      class="text-accent hover:underline focus-ring rounded inline-flex items-center gap-1 font-medium"
      aria-label={`Read article: ${post.data.title}`}
    >
      <span>Read article</span> <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
