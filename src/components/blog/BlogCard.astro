---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article
  class="flex flex-col justify-between rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-colors group h-full overflow-hidden shadow-sm"
  data-blog-card
  data-category={post.data.category}
  data-title={post.data.title.toLowerCase()}
  data-excerpt={post.data.excerpt.toLowerCase()}
  data-tags={post.data.tags.join(',').toLowerCase()}
>
  <div>
    <!-- Cover Image Thumbnail -->
    <a
      href={`/blog/${post.id}`}
      class="block aspect-[16/9] overflow-hidden bg-secondary-light dark:bg-secondary-dark border-b border-border dark:border-border-dark focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={post.data.cover}
        alt={post.data.coverAlt}
        width="600"
        height="338"
        class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300"
        loading="lazy"
      />
    </a>

    <div class="p-6">
      <!-- Category & Reading Time -->
      <div class="flex items-center justify-between gap-2 mb-3 text-xs font-mono">
        <span class="text-accent dark:text-accent-dark font-medium uppercase tracking-wider">
          {post.data.category}
        </span>
        <span class="text-muted dark:text-muted-dark">
          {readingTime.text}
        </span>
      </div>

      <!-- Article Title -->
      <h3 class="font-display text-xl font-bold text-primary dark:text-primary-dark mb-2.5 leading-snug">
        <a href={`/blog/${post.id}`} class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded">
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-muted dark:text-muted-dark font-sans leading-relaxed line-clamp-3 mb-4">
        {post.data.excerpt}
      </p>

      <!-- Tags list without pill fatigue -->
      <p class="text-xs font-mono text-muted dark:text-muted-dark border-t border-border dark:border-border-dark pt-3">
        {post.data.tags.map((t) => `#${t}`).join(' ')}
      </p>
    </div>
  </div>

  <!-- Footer Metadata -->
  <div class="px-6 py-3.5 border-t border-border dark:border-border-dark flex items-center justify-between text-xs font-mono">
    <time datetime={post.data.pubDate.toISOString()} class="text-muted dark:text-muted-dark">
      {formattedDate}
    </time>
    <a
      href={`/blog/${post.id}`}
      class="text-accent dark:text-accent-dark hover:underline focus-ring rounded inline-flex items-center gap-1 font-medium"
      aria-label={`Read article: ${post.data.title}`}
    >
      Read article &rarr;
    </a>
  </div>
</article>
