---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  class?: string;
}

const { id, title, eyebrow, class: className = '' } = Astro.props;
---

<section id={id} class={`my-12 scroll-mt-20 ${className}`}>
  {eyebrow && (
    <span class="text-xs font-semibold tracking-wider text-accent dark:text-accent-dark uppercase block mb-1">
      {eyebrow}
    </span>
  )}
  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary dark:text-primary-dark mb-6 border-b border-border dark:border-border-dark pb-3">
    {title}
  </h2>
  <div class="prose prose-slate dark:prose-invert max-w-none text-muted dark:text-muted-dark leading-relaxed">
    <slot />
  </div>
</section>

