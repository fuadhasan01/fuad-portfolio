---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | Fuad Hasan"
  description="The page you were looking for could not be found."
>
  <div class="max-w-2xl mx-auto px-6 py-28 text-center">
    <span class="inline-flex items-center px-3 py-1 rounded font-mono text-xs font-semibold text-accent dark:text-accent-dark mb-6 uppercase tracking-wider">
      404 // ROUTE NOT FOUND
    </span>
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mb-4 leading-tight">
      Page Not Found
    </h1>
    <p class="text-base text-muted dark:text-muted-dark mb-10 leading-relaxed font-sans max-w-md mx-auto">
      The coordinates you navigated to do not correspond to an active route on this system.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 font-mono text-xs">
      <a
        href="/"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded bg-accent dark:bg-accent-dark text-white dark:text-canvas-dark hover:opacity-95 transition-opacity focus-ring uppercase tracking-wider font-semibold"
      >
        Return Home
      </a>
      <a
        href="/projects"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-primary dark:hover:border-primary-dark transition-colors focus-ring uppercase tracking-wider"
      >
        Explore Projects
      </a>
      <a
        href="/blog"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-primary dark:hover:border-primary-dark transition-colors focus-ring uppercase tracking-wider"
      >
        Read Blog
      </a>
    </div>
  </div>
</BaseLayout>
