---
interface Props {
  title: string;
  skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark transition-colors">
  <h3 class="text-base font-bold text-primary dark:text-primary-dark mb-4 flex items-center justify-between">
    <span>{title}</span>
    <span class="text-xs font-normal text-muted dark:text-muted-dark font-mono">{skills.length} skills</span>
  </h3>
  <ul class="flex flex-wrap gap-2" role="list">
    {skills.map((skill) => (
      <li class="px-3 py-1 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60">
        {skill}
      </li>
    ))}
  </ul>
</div>

