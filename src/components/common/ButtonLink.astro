---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  external?: boolean;
  class?: string;
  download?: boolean | string;
}

const {
  href,
  variant = 'primary',
  external = false,
  class: className = '',
  download
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center rounded transition-all focus-ring text-xs font-mono uppercase tracking-wider px-5 py-2.5';

const variantStyles = {
  primary: 'bg-accent dark:bg-accent-dark text-white dark:text-canvas-dark hover:opacity-95 font-semibold',
  secondary: 'bg-secondary-light dark:bg-secondary-dark text-primary dark:text-primary-dark hover:bg-secondary-light/80 dark:hover:bg-secondary-dark/80 border border-border dark:border-border-dark',
  outline: 'border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition-colors'
};
---

<a
  href={href}
  class:list={[baseStyles, variantStyles[variant], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? (typeof download === 'string' ? download : true) : undefined}
>
  <slot />
</a>
