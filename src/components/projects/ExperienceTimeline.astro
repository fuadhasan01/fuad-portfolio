---
import type { ExperienceItem } from '../../data/experience';

interface Props {
  items: ExperienceItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<div class="divide-y divide-border dark:divide-border-dark border-y border-border dark:border-border-dark" role="list">
  {
    items.map((item) => (
      <article class="py-8 sm:py-10 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-10" role="listitem">
        <!-- Date Band & Location -->
        <div class="md:col-span-3 text-xs font-mono text-muted dark:text-muted-dark">
          <p class="font-medium text-primary dark:text-primary-dark">
            <time>{item.startDate}</time> &ndash; <time>{item.endDate}</time>
          </p>
          <p class="mt-1">{item.location}</p>
        </div>

        <!-- Role, Company & Contributions -->
        <div class="md:col-span-9">
          <h3 class="font-display text-xl sm:text-2xl font-bold text-primary dark:text-primary-dark mb-1">
            {item.role}
          </h3>
          <p class="text-sm font-mono font-medium text-accent dark:text-accent-dark mb-4">
            {item.company}
          </p>

          {!compact && (
            <div class="mb-5">
              <h4 class="font-mono text-xs uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
                Key Engineering Responsibilities
              </h4>
              <ul class="space-y-2 text-sm text-muted dark:text-muted-dark font-sans leading-relaxed list-disc list-inside">
                {item.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )}

          <p class="text-xs font-mono text-muted dark:text-muted-dark pt-3 border-t border-border dark:border-border-dark">
            <span class="text-primary dark:text-primary-dark font-medium">Applied Stack:</span> {item.technologies.join(' • ')}
          </p>
        </div>
      </article>
    ))
  }
</div>
