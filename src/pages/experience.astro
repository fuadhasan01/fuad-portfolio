---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experience';
import ExperienceTimeline from '../components/projects/ExperienceTimeline.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
---

<BaseLayout
  title="Experience | Fuad Hasan"
  description="Professional career timeline, engineering responsibilities, and verified contributions of Fuad Hasan."
>
  <div class="max-w-4xl mx-auto px-6 md:px-8 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-14">
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mb-3">
        Career Experience
      </h1>
      <p class="text-base text-muted dark:text-muted-dark font-sans leading-relaxed max-w-2xl">
        A chronological record of full-stack engineering roles, core backend architectures, database optimization, and enterprise systems.
      </p>
    </header>

    <!-- Career Ledger Component -->
    <section class="mb-16">
      <ExperienceTimeline items={experiences} />
    </section>

    <!-- Project Evidence Callout -->
    <section class="p-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
      <div>
        <h2 class="font-display text-2xl font-bold text-primary dark:text-primary-dark mb-2">
          Explore Technical Case Studies
        </h2>
        <p class="text-sm font-sans text-muted dark:text-muted-dark leading-relaxed max-w-lg">
          Detailed technical dossiers covering problem domain, architecture decisions, and code repositories.
        </p>
      </div>
      <div class="flex gap-3 w-full sm:w-auto flex-shrink-0 font-mono text-xs">
        <ButtonLink href="/projects" variant="primary">
          View Projects &rarr;
        </ButtonLink>
      </div>
    </section>
  </div>
</BaseLayout>
