---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import RelatedArticles from '../components/blog/RelatedArticles.astro';
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
  allPosts?: CollectionEntry<'blog'>[];
}

const { post, headings = [], allPosts = [] } = Astro.props;
const readingTime = getReadingTime(post.body || '');
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<BaseLayout
  title={`${post.data.title} | Fuad Hasan`}
  description={post.data.excerpt}
  image={post.data.cover}
  article={true}
  articleData={{
    headline: post.data.title,
    description: post.data.excerpt,
    datePublished: post.data.pubDate,
    dateModified: post.data.updatedDate,
    image: post.data.cover
  }}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Breadcrumb (wireframe_article.png) -->
    <nav class="flex items-center space-x-2 font-mono text-xs text-muted dark:text-muted-dark uppercase tracking-wider mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring rounded">Home</a>
      <span aria-hidden="true" class="text-border dark:text-border-dark">/</span>
      <a href="/blog" class="hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring rounded">Blog</a>
      <span aria-hidden="true" class="text-border dark:text-border-dark">/</span>
      <span class="text-primary dark:text-primary-dark font-medium truncate" aria-current="page">{post.data.category}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 max-w-4xl">
      <div class="flex items-center gap-3 mb-4 font-mono text-xs">
        <span class="text-accent dark:text-accent-dark font-medium uppercase tracking-wider">
          {post.data.category}
        </span>
        <span class="text-border dark:text-border-dark" aria-hidden="true">•</span>
        <span class="text-muted dark:text-muted-dark">
          {readingTime.text}
        </span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mb-5 leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-muted dark:text-muted-dark font-sans leading-relaxed mb-6 max-w-3xl">
        {post.data.excerpt}
      </p>

      <!-- Metadata Bar -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 font-mono text-xs text-muted dark:text-muted-dark py-4 border-y border-border dark:border-border-dark">
        <time datetime={post.data.pubDate.toISOString()} class="text-primary dark:text-primary-dark font-medium">
          {formattedDate}
        </time>
        <span aria-hidden="true" class="text-border dark:text-border-dark">•</span>
        <div class="flex flex-wrap gap-2" aria-label="Article tags">
          {post.data.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Split 2-Column Grid (wireframe_article.png) with min-w-0 for grid overflow containment -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Article Body (lg:col-span-8 min-w-0 prevents code overflow) -->
      <main class="lg:col-span-8 min-w-0 max-w-full">
        <!-- Hero Cover Image -->
        {post.data.cover && (
          <figure class="mb-10 rounded-lg overflow-hidden border border-border dark:border-border-dark bg-secondary-light dark:bg-secondary-dark shadow-sm">
            <img
              src={post.data.cover}
              alt={post.data.coverAlt}
              width="800"
              height="450"
              class="w-full h-auto object-cover"
              loading="eager"
            />
            {post.data.coverAlt && (
              <figcaption class="p-3 text-center font-mono text-xs text-slate-300 dark:text-slate-400 bg-slate-900/90 border-t border-slate-800">
                {post.data.coverAlt}
              </figcaption>
            )}
          </figure>
        )}

        <!-- Mobile TOC: ONLY renders the collapsible accordion, hidden on desktop (lg:hidden) -->
        <TableOfContents headings={headings} variant="mobile" />

        <!-- Markdown Body (Uses our dedicated .article-content and .prose typography) -->
        <article class="article-content prose max-w-none">
          <slot />
        </article>

        <!-- Article Footer: Back Link -->
        <div class="mt-14 pt-8 border-t border-border dark:border-border-dark flex items-center justify-between font-mono text-xs">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 uppercase tracking-wider text-accent dark:text-accent-dark hover:underline focus-ring rounded font-medium"
          >
            <span aria-hidden="true">&larr;</span> Back to all articles
          </a>
          <a
            href="#top"
            class="uppercase tracking-wider text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors focus-ring rounded"
          >
            Back to top &uarr;
          </a>
        </div>
      </main>

      <!-- Right Column: Sticky Sidebar (lg:col-span-4) -->
      <aside class="hidden lg:block lg:col-span-4 min-w-0 sticky top-24 space-y-6">
        <!-- Desktop TOC: ONLY renders the desktop sidebar card -->
        <TableOfContents headings={headings} variant="desktop" />
        {allPosts.length > 0 && (
          <RelatedArticles
            currentSlug={post.id}
            category={post.data.category}
            tags={post.data.tags}
            posts={allPosts}
          />
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Technical Blog Enhancement Scripts:
  // 1. Wrap code blocks with macOS header bar, language badge, and copy button (CMP-16, FR-024)
  // 2. Wrap tables with horizontal scroll containers
  // 3. Table of contents scrollspy (active heading indicator)
  // 4. Smooth scroll with sticky navbar offset

  function initTechnicalArticleEnhancements() {
    initCodeBlockWrappers();
    initResponsiveTables();
    initScrollSpy();
    initSmoothAnchorScrolling();
  }

  function initCodeBlockWrappers() {
    const preBlocks = document.querySelectorAll('.article-content pre.astro-code, article pre');

    preBlocks.forEach((pre) => {
      // Avoid duplicate wrapping
      if (pre.closest('.code-block-wrapper')) return;

      // Extract language from data-language attribute or class
      let lang = pre.getAttribute('data-language') || '';
      if (!lang) {
        const classMatch = pre.className.match(/language-(\w+)/);
        if (classMatch) lang = classMatch[1];
      }

      // Friendly display mapping
      const langMap: Record<string, string> = {
        csharp: 'C#',
        cs: 'C#',
        typescript: 'TypeScript',
        ts: 'TypeScript',
        javascript: 'JavaScript',
        js: 'JavaScript',
        sql: 'SQL',
        json: 'JSON',
        bash: 'Bash',
        sh: 'Bash',
        shell: 'Shell',
        html: 'HTML',
        css: 'CSS',
        yaml: 'YAML',
        yml: 'YAML',
        markdown: 'Markdown',
        md: 'Markdown',
        xml: 'XML',
        dockerfile: 'Docker',
        diff: 'Diff'
      };

      const normalized = lang.toLowerCase();
      const displayLang = langMap[normalized] || (lang ? lang.toUpperCase() : 'CODE');

      // Create outer wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      // Create top toolbar
      const header = document.createElement('div');
      header.className = 'code-block-header';

      // Left meta: terminal indicator dots + language badge
      const meta = document.createElement('div');
      meta.className = 'code-block-meta';
      meta.innerHTML = `
        <div class="code-terminal-dots" aria-hidden="true">
          <span class="code-terminal-dot"></span>
          <span class="code-terminal-dot"></span>
          <span class="code-terminal-dot"></span>
        </div>
        <span class="code-language-tag">${displayLang}</span>
      `;

      // Right action: Accessible Copy Button
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy-btn';
      copyBtn.setAttribute('aria-label', `Copy ${displayLang} code snippet to clipboard`);
      copyBtn.innerHTML = `
        <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span class="copy-text">Copy</span>
      `;

      copyBtn.addEventListener('click', async () => {
        const codeElement = pre.querySelector('code');
        const textToCopy = (codeElement ? codeElement.innerText : (pre as HTMLElement).innerText).replace(/\n$/, '');

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="copy-text">Copied!</span>
          `;
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = `
              <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-text">Copy</span>
            `;
          }, 2000);
        } catch {
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = '<span class="copy-text">Copied!</span>';
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = '<span class="copy-text">Copy</span>';
          }, 2000);
        }
      });

      header.appendChild(meta);
      header.appendChild(copyBtn);

      // Insert wrapper before pre, then move pre inside wrapper
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });
  }

  function initResponsiveTables() {
    const tables = document.querySelectorAll('.article-content table');
    tables.forEach((table) => {
      if (table.parentElement?.classList.contains('article-table-container')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'article-table-container';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  }

  function initScrollSpy() {
    const headings = document.querySelectorAll('.article-content h2[id], .article-content h3[id]');
    const desktopTocLinks = document.querySelectorAll('aside .toc-link[data-toc-slug]');
    if (headings.length === 0 || desktopTocLinks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            desktopTocLinks.forEach((link) => {
              if (link.getAttribute('data-toc-slug') === id) {
                link.classList.add('is-active');
              } else {
                link.classList.remove('is-active');
              }
            });
          }
        });
      },
      {
        rootMargin: '-80px 0px -70% 0px',
        threshold: 0
      }
    );

    headings.forEach((h) => observer.observe(h));
  }

  function initSmoothAnchorScrolling() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-container a[href^="#"], a[href^="#"]');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || href === '#') return;
        const targetId = href.slice(1);
        if (targetId === 'top') {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          history.pushState(null, '', ' ');
          return;
        }

        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          const topOffset = 88; // 64px sticky header + 24px margin
          const elementPosition = targetEl.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - topOffset;
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
          history.pushState(null, '', `#${targetId}`);
        }
      });
    });
  }

  initTechnicalArticleEnhancements();
  document.addEventListener('astro:page-load', initTechnicalArticleEnhancements);
</script>
