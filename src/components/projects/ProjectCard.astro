---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  category,
  technologies,
  cover,
  coverAlt,
  repositoryUrl,
  demoUrl,
  timeline
} = project.data;
---

<article
  class="flex flex-col justify-between border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark hover:border-accent dark:hover:border-accent-dark transition-colors rounded-lg overflow-hidden group shadow-sm"
  data-category={category}
  data-technologies={technologies.join(',')}
  data-project-card
>
  <div>
    <!-- Project Thumbnail / Diagram -->
    <a
      href={`/projects/${project.id}`}
      class="block aspect-[16/10] overflow-hidden bg-secondary-light dark:bg-secondary-dark border-b border-border dark:border-border-dark focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={cover}
        alt={coverAlt}
        width="600"
        height="375"
        class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300"
        loading="lazy"
      />
    </a>

    <div class="p-6">
      <!-- Category & Timeline Meta -->
      <div class="flex items-center justify-between text-xs font-mono text-muted dark:text-muted-dark mb-3">
        <span class="text-accent dark:text-accent-dark font-medium uppercase tracking-wider">{category}</span>
        <span>{timeline || '2024'}</span>
      </div>

      <!-- Title -->
      <h3 class="text-xl font-display font-bold text-primary dark:text-primary-dark mb-2.5">
        <a
          href={`/projects/${project.id}`}
          class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded inline-block"
        >
          {title}
        </a>
      </h3>

      <!-- Summary -->
      <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-3 mb-4 font-sans">
        {summary}
      </p>

      <!-- Technical Stack without Pill Fatigue -->
      <p class="text-xs font-mono text-muted dark:text-muted-dark border-t border-border dark:border-border-dark pt-3">
        <span class="text-primary dark:text-primary-dark font-medium">Stack:</span> {technologies.slice(0, 4).join(' • ')}
        {technologies.length > 4 && <span> • +{technologies.length - 4}</span>}
      </p>
    </div>
  </div>

  <!-- Action Links Footer -->
  <div class="px-6 py-3.5 border-t border-border dark:border-border-dark flex items-center justify-between font-mono text-xs">
    <a
      href={`/projects/${project.id}`}
      class="text-accent dark:text-accent-dark font-medium hover:underline focus-ring"
      aria-label={`Case Study: ${title}`}
    >
      <span>Case Study</span> <span aria-hidden="true">&rarr;</span>
    </a>

    <div class="flex items-center space-x-3 text-xs">
      {repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors focus-ring"
          aria-label={`Source: ${title} on GitHub (opens in new tab)`}
        >
          <span>Source</span> <span aria-hidden="true">&nearr;</span>
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors focus-ring"
          aria-label={`Demo: ${title} live demonstration (opens in new tab)`}
        >
          <span>Demo</span> <span aria-hidden="true">&nearr;</span>
        </a>
      )}
    </div>
  </div>
</article>
