---
import { profile } from '../../data/profile';
---

<footer class="mt-auto border-t border-border dark:border-border-dark py-10 px-6 md:px-12 max-w-6xl mx-auto w-full flex flex-col md:flex-row items-center justify-between gap-6 transition-colors" role="contentinfo">
  <p class="text-xs text-muted dark:text-muted-dark font-mono tracking-wide">
    &copy; {new Date().getFullYear()} {profile.name}
  </p>

  <p class="text-xs text-muted dark:text-muted-dark text-center">
    Built with precision. Deployed with confidence.
  </p>

  <div class="flex items-center gap-3">
    {
      profile.socialLinks.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 border border-border dark:border-border-dark flex items-center justify-center text-xs font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-200 focus-ring"
          aria-label={`${social.name.slice(0, 2).toUpperCase()} - ${social.name}`}
          title={social.name}
        >
          {social.name.slice(0, 2).toUpperCase()}
        </a>
      ))
    }
    <a
      href="/rss.xml"
      class="w-9 h-9 border border-border dark:border-border-dark flex items-center justify-center text-xs font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-200 focus-ring"
      aria-label="RSS - RSS Feed"
      title="RSS Feed"
    >
      RSS
    </a>
  </div>
</footer>


