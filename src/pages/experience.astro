---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experience';
import ExperienceTimeline from '../components/projects/ExperienceTimeline.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
---

<BaseLayout
  title="Experience | Fuad Hasan"
  description="Professional career timeline, engineering responsibilities, and verified contributions of Fuad Hasan."
>
  <div>
    <!-- Header -->
    <header class="mb-10">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-heading mb-2.5">
        Career Experience
      </h1>
      <p class="text-sm sm:text-base text-muted font-sans leading-relaxed max-w-2xl">
        A chronological record of full-stack engineering roles, core backend architectures, database optimization, and enterprise systems.
      </p>
    </header>

    <!-- Career Ledger Component -->
    <section class="mb-12">
      <ExperienceTimeline items={experiences} />
    </section>

    <!-- Project Evidence Callout -->
    <section class="p-6 rounded-lg bg-surface border border-border-card flex flex-col sm:flex-row items-center justify-between gap-5 shadow-sm">
      <div>
        <h2 class="font-heading text-xl font-bold text-heading mb-1.5">
          Explore Technical Case Studies
        </h2>
        <p class="text-sm font-sans text-muted leading-relaxed max-w-lg">
          Detailed technical dossiers covering problem domain, architecture decisions, and code repositories.
        </p>
      </div>
      <div class="flex gap-3 w-full sm:w-auto flex-shrink-0">
        <ButtonLink href="/projects" variant="primary">
          View Projects &rarr;
        </ButtonLink>
      </div>
    </section>
  </div>
</BaseLayout>
