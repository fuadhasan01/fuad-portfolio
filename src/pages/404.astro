---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | Fuad Hasan"
  description="The page you were looking for could not be found."
>
  <div class="py-20 text-center max-w-lg mx-auto">
    <span class="inline-flex items-center px-2.5 py-0.5 rounded font-mono text-xs font-semibold text-accent mb-4 uppercase tracking-wider bg-subtle">
      404 // Route Not Found
    </span>
    <h1 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-heading mb-3">
      Page Not Found
    </h1>
    <p class="text-sm sm:text-base text-muted mb-8 leading-relaxed font-sans">
      The coordinates you navigated to do not correspond to an active route on this system.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2.5 font-mono text-xs">
      <a
        href="/"
        class="btn-primary"
      >
        Return Home
      </a>
      <a
        href="/projects"
        class="btn-secondary"
      >
        Explore Projects
      </a>
      <a
        href="/blog"
        class="btn-secondary"
      >
        Read Blog
      </a>
    </div>
  </div>
</BaseLayout>
