---
interface Props {
  title: string;
  skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="p-5 rounded-lg bg-surface border border-border-card transition-colors">
  <h3 class="font-heading text-sm font-bold text-heading mb-3 flex items-center justify-between">
    <span>{title}</span>
    <span class="text-xs font-normal text-muted font-mono">{skills.length} skills</span>
  </h3>
  <div class="flex flex-wrap gap-1.5">
    {skills.map((skill) => (
      <span class="chip-tag text-xs">
        {skill}
      </span>
    ))}
  </div>
</div>
