---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
  title,
  summary,
  category,
  technologies,
  cover,
  coverAlt,
  repositoryUrl,
  frontendRepositoryUrl,
  demoUrl,
  role,
  timeline,
  status,
} = project.data;
---

<BaseLayout
  title={`${title} - Case Study | Fuad Hasan`}
  description={summary}
  image={cover}
>
  <div>
    <!-- Breadcrumb -->
    <nav
      class="flex items-center space-x-2 text-xs font-mono text-muted mb-6"
      aria-label="Breadcrumb"
    >
      <a
        href="/"
        class="hover:text-accent transition-colors focus-ring rounded"
      >
        Home
      </a>
      <span aria-hidden="true">/</span>
      <a
        href="/projects"
        class="hover:text-accent transition-colors focus-ring rounded"
      >
        Projects
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-heading font-medium truncate" aria-current="page">
        {title}
      </span>
    </nav>

    <!-- Case Study Header -->
    <header class="mb-10 pb-8 border-b border-border">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <!-- Overview & Action Column (Left) -->
        <div class="md:col-span-7">
          <div class="flex items-center gap-2.5 mb-2.5 font-mono text-xs">
            <span class="text-accent font-semibold uppercase tracking-wider">
              {category}
            </span>
            <span class="text-muted" aria-hidden="true">
              •
            </span>
            <span class="text-muted">Architecture Case Study</span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold tracking-tight text-heading mb-3">
            {title}
          </h1>

          <p class="text-sm sm:text-base text-body leading-relaxed mb-6 font-sans">
            {summary}
          </p>

          <!-- Metadata Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 py-3 border-y border-border mb-6 text-xs font-mono">
            <div>
              <span class="block text-muted uppercase tracking-wider mb-0.5">
                Role
              </span>
              <span class="font-medium text-heading">{role}</span>
            </div>
            {timeline && (
              <div>
                <span class="block text-muted uppercase tracking-wider mb-0.5">
                  Timeline
                </span>
                <span class="font-medium text-heading">{timeline}</span>
              </div>
            )}
            <div>
              <span class="block text-muted uppercase tracking-wider mb-0.5">
                Status
              </span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-accent capitalize">
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                {status}
              </span>
            </div>
          </div>

          <!-- Technologies Badges -->
          <div class="mb-6">
            <span class="sr-only">Technologies used:</span>
            <div class="flex flex-wrap gap-1.5">
              {technologies.map((tech) => (
                <span class="chip-tag text-[11px] py-0.5 px-2">{tech}</span>
              ))}
            </div>
          </div>

          <!-- Action Buttons (FR-008: Source & Demo links shown only when verified) -->
          <div class="flex flex-wrap gap-2.5 font-mono text-xs">
            {repositoryUrl && (
              <a
                href={repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
                aria-label={`${frontendRepositoryUrl ? "Backend Repo" : "View Repository"}: ${title} on GitHub (opens in new tab)`}
              >
                <span>
                  {frontendRepositoryUrl ? "Backend Repo" : "View Repository"}
                </span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
            {frontendRepositoryUrl && (
              <a
                href={frontendRepositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
                aria-label={`Frontend Repo: ${title} on GitHub (opens in new tab)`}
              >
                <span>Frontend Repo</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
            {demoUrl && (
              <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
                aria-label={`Live Demo: ${title} (opens in new tab)`}
              >
                <span>Live Demo</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
        </div>

        <!-- Cover Preview Container (Right) -->
        <div class="md:col-span-5">
          <figure class="relative overflow-hidden rounded-lg border border-border-card bg-surface shadow-sm">
            <img
              src={cover}
              alt={coverAlt}
              width="800"
              height="480"
              class="w-full h-auto object-cover"
              loading="eager"
            />
            <figcaption class="p-2.5 text-center text-xs font-mono text-muted border-t border-border">
              {coverAlt}
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- Case Study Body (Prose) -->
    <article class="article-content max-w-prose-article">
      <slot />
    </article>

    <!-- Back to projects footer -->
    <div class="mt-12 pt-6 border-t border-border flex items-center justify-between font-mono text-xs">
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-accent hover:underline focus-ring rounded font-medium"
      >
        <span aria-hidden="true">&larr;</span> Back to all projects
      </a>
      <a
        href="#main-content"
        class="text-muted hover:text-heading transition-colors focus-ring rounded"
      >
        Back to top &uarr;
      </a>
    </div>
  </div>
</BaseLayout>
