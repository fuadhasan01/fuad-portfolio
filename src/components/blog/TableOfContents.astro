---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
  variant?: 'mobile' | 'desktop' | 'auto';
}

const { headings, variant = 'auto' } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const showMobile = (variant === 'mobile' || variant === 'auto') && tocHeadings.length > 0;
const showDesktop = (variant === 'desktop' || variant === 'auto') && tocHeadings.length > 0;

const navAriaLabel = variant === 'mobile' ? 'Table of contents (mobile)' : 'Table of contents';
---

{
  tocHeadings.length > 0 && (
    <nav
      class:list={[
        'toc-container',
        variant === 'mobile' ? 'lg:hidden' : ''
      ]}
      aria-label={navAriaLabel}
    >
      {/* Mobile Collapsible Accordion (only on mobile/tablet < 1020px) */}
      {showMobile && (
        <details class="p-3.5 rounded-lg border border-border bg-surface group mb-6 lg:hidden">
          <summary class="font-mono text-xs uppercase tracking-wider text-heading cursor-pointer list-none flex items-center justify-between focus-ring rounded p-1">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              <span class="font-semibold">Table of Contents</span>
            </span>
            <span class="text-xs text-muted group-open:rotate-180 transition-transform" aria-hidden="true">
              ▼
            </span>
          </summary>
          <ul class="mt-2.5 space-y-1 text-xs font-mono border-t border-border pt-2.5">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'ml-3' : ''}>
                <a
                  href={`#${h.slug}`}
                  class="text-muted hover:text-accent transition-colors block py-1 px-1.5 rounded focus-ring"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      {/* Desktop Sticky Sidebar Box (only on desktop >= 1020px) */}
      {showDesktop && (
        <div class="hidden lg:block p-5 rounded-lg border border-border-card bg-surface shadow-sm">
          <h3 class="text-xs font-mono tracking-wider text-heading uppercase mb-3 flex items-center gap-2 font-semibold">
            <span class="w-1.5 h-1.5 rounded-sm bg-accent" aria-hidden="true"></span>
            On This Page
          </h3>
          <ul class="space-y-0.5 text-xs font-mono border-l border-border">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'ml-2.5' : ''}>
                <a
                  href={`#${h.slug}`}
                  data-toc-slug={h.slug}
                  class:list={[
                    'toc-link text-muted hover:text-accent transition-colors block py-1 px-2.5 -ml-px border-l-2 border-transparent hover:border-accent rounded-r focus-ring leading-relaxed',
                    h.depth === 3 ? 'text-[11px]' : ''
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>
  )
}
