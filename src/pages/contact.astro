---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import SectionHeading from '../components/common/SectionHeading.astro';
import SocialIcon from '../components/common/SocialIcon.astro';
---

<BaseLayout
  title="Contact | Fuad Hasan"
  description="Get in touch with Fuad Hasan for full-stack engineering opportunities, architecture consulting, and professional collaboration."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-14">
      <SectionHeading
        eyebrow="COMMUNICATION"
        title="Get in Touch"
        description="I am open to full-time software engineering roles, technical architecture collaborations, and technical discussions. You can connect with me through the channels below."
      />
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Direct Email Card -->
      <div class="p-8 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg border border-border dark:border-border-dark bg-secondary-light/40 dark:bg-secondary-dark/40 text-accent dark:text-accent-dark flex items-center justify-center mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="font-serif text-2xl font-normal text-primary dark:text-primary-dark mb-2">
            Direct Email
          </h2>
          <p class="text-sm font-sans text-muted dark:text-muted-dark leading-relaxed mb-8">
            The fastest way to reach me for job opportunities, inquiries regarding my project work, or technical discussions.
          </p>
        </div>

        <div>
          <a
            id="email-cta-link"
            href="mailto:contact@fuadhasan.dev"
            class="inline-flex items-center justify-center w-full px-5 py-3 text-xs font-mono uppercase tracking-wider font-semibold rounded-lg bg-accent dark:bg-accent-dark text-white dark:text-[#09090E] hover:opacity-90 transition-opacity focus-ring"
          >
            Send Email (mailto) &rarr;
          </a>
          <button
            id="copy-email-button"
            type="button"
            class="mt-3 w-full inline-flex items-center justify-center px-4 py-2.5 text-xs font-mono uppercase tracking-wider rounded-lg border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark hover:border-primary dark:hover:border-primary-dark transition-colors focus-ring"
          >
            Copy Email Address
          </button>
          <p id="copy-email-status" class="text-xs font-mono text-center text-accent dark:text-accent-dark mt-2.5 hidden" role="status" aria-live="polite">
            Email address copied to clipboard!
          </p>
        </div>
      </div>

      <!-- Professional Profiles Card -->
      <div class="p-8 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg border border-border dark:border-border-dark bg-secondary-light/40 dark:bg-secondary-dark/40 text-accent dark:text-accent-dark flex items-center justify-center mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h2 class="font-serif text-2xl font-normal text-primary dark:text-primary-dark mb-2">
            Engineering Profiles
          </h2>
          <p class="text-sm font-sans text-muted dark:text-muted-dark leading-relaxed mb-8">
            Inspect my open-source code repositories, competitive programming track record, and verified professional network.
          </p>
        </div>

        <ul class="space-y-2.5" role="list">
          {
            profile.socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-3 rounded-lg border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark hover:bg-secondary-light/40 dark:hover:bg-secondary-dark/40 transition-colors focus-ring"
                >
                  <div class="flex items-center gap-3">
                    <SocialIcon name={social.icon || social.name} class="w-4 h-4 text-muted dark:text-muted-dark" />
                    <span class="text-xs font-mono text-primary dark:text-primary-dark font-medium">{social.name}</span>
                  </div>
                  <span class="text-xs text-muted dark:text-muted-dark font-mono">&nearr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Resume Access & Privacy Safe Handling (FR-009, SEC-06) -->
    <section class="p-8 sm:p-10 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h2 class="font-serif text-2xl font-normal text-primary dark:text-primary-dark">Download Resume</h2>
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-accent/40 dark:border-accent-dark/40 text-accent dark:text-accent-dark uppercase">
              PDF
            </span>
          </div>
          <p class="text-sm font-sans text-muted dark:text-muted-dark leading-relaxed max-w-xl">
            A comprehensive overview of my software engineering experience, education, and technical stack. Sanitized for public download to protect personal phone and residential address privacy.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a
            href={profile.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-mono uppercase tracking-wider rounded-lg border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring font-medium"
          >
            Download CV &nearr;
          </a>
        </div>
      </div>
    </section>

    <!-- Privacy Note (SEC-06) -->
    <div class="mt-8 text-center text-xs font-mono text-muted dark:text-muted-dark">
      <p>
        Privacy notice: Personal phone number and residential address are intentionally withheld from public display in compliance with personal privacy standards.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  function setupContactPage() {
    const copyBtn = document.getElementById('copy-email-button');
    const status = document.getElementById('copy-email-status');
    const emailLink = document.getElementById('email-cta-link') as HTMLAnchorElement | null;

    if (!copyBtn || !status) return;

    copyBtn.addEventListener('click', async () => {
      const email = emailLink?.getAttribute('href')?.replace('mailto:', '') || 'contact@fuadhasan.dev';
      try {
        await navigator.clipboard.writeText(email);
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 3500);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }

  setupContactPage();
  document.addEventListener('astro:after-swap', setupContactPage);
</script>
