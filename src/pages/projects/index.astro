---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout
  title="Projects & Case Studies | Fuad Hasan"
  description="Software engineering projects, architectural case studies, and code repositories by Fuad Hasan."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-12">
      <span class="text-xs font-semibold tracking-wider text-accent dark:text-accent-dark uppercase">
        PORTFOLIO
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-primary dark:text-primary-dark mt-2 mb-4">
        Projects & Case Studies
      </h1>
      <p class="text-lg text-muted dark:text-muted-dark leading-relaxed max-w-3xl">
        A selection of full-stack systems, architectural implementations, and database-driven applications. Each project includes an in-depth case study of design decisions and technical trade-offs.
      </p>
    </header>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => (
          <article class="flex flex-col justify-between p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-all hover:shadow-md">
            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.data.technologies.slice(0, 3).map((tech) => (
                  <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    {tech}
                  </span>
                ))}
              </div>
              <h2 class="text-xl font-bold text-primary dark:text-primary-dark mb-2">
                <a href={`/projects/${project.id}`} class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded">
                  {project.data.title}
                </a>
              </h2>
              <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4">
                {project.data.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-border dark:border-border-dark flex items-center justify-between">
              <a
                href={`/projects/${project.id}`}
                class="text-sm font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded"
              >
                Read Case Study &rarr;
              </a>
              {project.data.repositoryUrl && (
                <a
                  href={project.data.repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark"
                >
                  GitHub &nearr;
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

