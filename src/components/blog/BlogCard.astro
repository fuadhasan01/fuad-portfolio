---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article
  class="flex flex-col justify-between rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-300 group h-full overflow-hidden"
  data-blog-card
  data-category={post.data.category}
  data-title={post.data.title.toLowerCase()}
  data-excerpt={post.data.excerpt.toLowerCase()}
  data-tags={post.data.tags.join(',').toLowerCase()}
>
  <div>
    <!-- Cover Image Thumbnail -->
    <a
      href={`/blog/${post.id}`}
      class="block aspect-[16/9] overflow-hidden bg-slate-900 border-b border-border dark:border-border-dark focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={post.data.cover}
        alt={post.data.coverAlt}
        width="600"
        height="338"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </a>

    <div class="p-6">
      <!-- Category Badge & Reading Time -->
      <div class="flex items-center justify-between gap-2 mb-4">
        <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-mono uppercase tracking-wider bg-transparent text-accent dark:text-accent-dark border border-accent/40 dark:border-accent-dark/40 font-medium">
          {post.data.category}
        </span>
        <span class="text-xs font-mono text-muted dark:text-muted-dark">
          {readingTime.text}
        </span>
      </div>

      <!-- Article Title -->
      <h3 class="font-serif text-2xl font-normal text-primary dark:text-primary-dark mb-3 tracking-tight group-hover:text-accent dark:group-hover:text-accent-dark transition-colors leading-snug">
        <a href={`/blog/${post.id}`} class="focus-ring rounded">
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-muted dark:text-muted-dark font-sans leading-relaxed line-clamp-3 mb-5">
        {post.data.excerpt}
      </p>

      <!-- Tags Pills -->
      <div class="flex flex-wrap gap-1.5" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-mono rounded border border-border dark:border-border-dark text-muted dark:text-muted-dark">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Footer Metadata -->
  <div class="px-6 py-4 border-t border-border dark:border-border-dark flex items-center justify-between text-xs font-mono bg-secondary-light/20 dark:bg-secondary-dark/20">
    <time datetime={post.data.pubDate.toISOString()} class="text-muted dark:text-muted-dark">
      {formattedDate}
    </time>
    <a
      href={`/blog/${post.id}`}
      class="font-mono text-xs uppercase tracking-wider text-accent dark:text-accent-dark hover:underline focus-ring rounded inline-flex items-center gap-1"
      aria-label={`Read article: ${post.data.title}`}
    >
      Read article <span>&rarr;</span>
    </a>
  </div>
</article>
