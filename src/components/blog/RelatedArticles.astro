---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  currentSlug: string;
  category: string;
  tags: string[];
  posts: CollectionEntry<'blog'>[];
}

const { currentSlug, category, tags, posts } = Astro.props;

// Filter out current article and find related articles
const related = posts
  .filter((p) => p.id !== currentSlug)
  .map((p) => {
    let score = 0;
    if (p.data.category === category) score += 2;
    const tagMatches = p.data.tags.filter((t) => tags.includes(t)).length;
    score += tagMatches;
    return { post: p, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 2)
  .map((item) => item.post);
---

{
  related.length > 0 && (
    <div class="mt-6 p-5 rounded-lg border border-border-card bg-surface shadow-sm">
      <h3 class="text-xs font-mono tracking-wider text-heading uppercase mb-3 flex items-center gap-2 font-semibold">
        <span class="w-1.5 h-1.5 rounded-sm bg-accent"></span>
        Related Reading
      </h3>
      <div class="space-y-4">
        {related.map((post) => {
          const rt = getReadingTime(post.body || '');
          return (
            <div class="group border-b border-border pb-3.5 last:border-b-0 last:pb-0">
              <span class="text-xs font-mono uppercase tracking-wider text-accent block mb-1">
                {post.data.category}
              </span>
              <a
                href={`/blog/${post.id}`}
                class="font-heading text-sm font-bold text-heading group-hover:text-accent transition-colors line-clamp-2 block mb-1 focus-ring rounded leading-snug"
              >
                {post.data.title}
              </a>
              <span class="text-xs font-mono text-muted">
                {rt.text}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  )
}
