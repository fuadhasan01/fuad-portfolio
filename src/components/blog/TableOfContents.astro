---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && (
    <nav class="toc-container" aria-label="Table of contents">
      <!-- Mobile Collapsible Accordion -->
      <details class="lg:hidden mb-8 p-4 rounded-xl border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark group">
        <summary class="font-semibold text-sm text-primary dark:text-primary-dark cursor-pointer list-none flex items-center justify-between focus-ring rounded p-1">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>Table of Contents</span>
          </span>
          <span class="text-xs text-muted dark:text-muted-dark group-open:rotate-180 transition-transform">
            ▼
          </span>
        </summary>
        <ul class="mt-3 space-y-2 text-sm border-t border-border dark:border-border-dark pt-3">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'ml-4' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors block py-0.5 focus-ring rounded"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <!-- Desktop Sticky Sidebar Box -->
      <div class="hidden lg:block p-5 rounded-2xl border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm">
        <h3 class="text-xs font-semibold tracking-wider text-muted dark:text-muted-dark uppercase mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          On This Page
        </h3>
        <ul class="space-y-2 text-sm">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'ml-3' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors block py-0.5 focus-ring rounded leading-snug"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

