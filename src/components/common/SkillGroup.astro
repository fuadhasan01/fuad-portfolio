---
interface Props {
  title: string;
  skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="p-6 rounded-lg bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark transition-colors">
  <h3 class="font-display text-base font-bold text-primary dark:text-primary-dark mb-3 flex items-center justify-between">
    <span>{title}</span>
    <span class="text-xs font-normal text-muted dark:text-muted-dark font-mono">{skills.length} competencies</span>
  </h3>
  <p class="text-xs font-mono text-muted dark:text-muted-dark leading-relaxed">
    {skills.join(' • ')}
  </p>
</div>
