---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="flex flex-col justify-between p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-all hover:shadow-md h-full">
  <div>
    <!-- Technology tags -->
    <div class="flex flex-wrap gap-1.5 mb-3" aria-label="Technologies used">
      {project.data.technologies.slice(0, 3).map((tech) => (
        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
          {tech}
        </span>
      ))}
      {project.data.technologies.length > 3 && (
        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-slate-50 dark:bg-slate-800/40 text-muted dark:text-muted-dark">
          +{project.data.technologies.length - 3}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-primary dark:text-primary-dark mb-2 tracking-tight">
      <a href={`/projects/${project.id}`} class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded">
        {project.data.title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-3 mb-6">
      {project.data.summary}
    </p>
  </div>

  <!-- Actions / Footer -->
  <div class="pt-4 border-t border-border dark:border-border-dark flex items-center justify-between text-sm">
    <a
      href={`/projects/${project.id}`}
      class="font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded"
    >
      Case Study &rarr;
    </a>
    {project.data.repositoryUrl && (
      <a
        href={project.data.repositoryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark focus-ring rounded p-1"
        aria-label={`${project.data.title} GitHub repository (opens in new tab)`}
      >
        Source &nearr;
      </a>
    )}
  </div>
</article>

