---
import type { ExperienceItem } from '../../data/experience';

interface Props {
  items: ExperienceItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<ol class="relative border-l border-slate-200 dark:border-slate-800 ml-3 space-y-10" role="list">
  {
    items.map((item) => (
      <li class="mb-10 ml-6">
        <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -left-3 ring-8 ring-white dark:ring-[#0B1220] dark:bg-blue-900">
          <span class="w-2.5 h-2.5 rounded-full bg-accent dark:bg-accent-dark"></span>
        </span>
        <div class="p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h3 class="text-lg sm:text-xl font-bold text-primary dark:text-primary-dark">
              {item.role}
            </h3>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-accent dark:text-accent-dark w-fit">
              <time>{item.startDate}</time> &ndash; <time>{item.endDate}</time>
            </span>
          </div>
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4">
            {item.company} &bull; <span class="text-muted dark:text-muted-dark font-normal">{item.location}</span>
          </p>

          {!compact && (
            <div class="mb-5">
              <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-2">
                Verified Responsibilities
              </h4>
              <ul class="space-y-1.5 text-sm text-slate-700 dark:text-slate-300 list-disc list-inside">
                {item.contributions.map((c) => (
                  <li class="leading-relaxed">{c}</li>
                ))}
              </ul>
            </div>
          )}

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border dark:border-border-dark">
            {item.technologies.map((tech) => (
              <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ol>

