---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { experiences } from '../data/experience';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
import SectionHeading from '../components/common/SectionHeading.astro';

const projects = await getCollection('projects', ({ data }) => data.featured);
const blogPosts = await getCollection('blog', ({ data }) => data.published);
const recentPosts = blogPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24" aria-label="Introduction">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Hero Left: Content & CTAs -->
      <div class="lg:col-span-8">
        <span class="text-xs sm:text-sm font-semibold tracking-wider text-accent dark:text-accent-dark uppercase block mb-2">
          FULL STACK SOFTWARE ENGINEER
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-primary dark:text-primary-dark mb-4">
          {profile.name}
        </h1>
        <p class="text-xl sm:text-2xl font-semibold text-slate-800 dark:text-slate-100 mb-4 leading-snug">
          {profile.heroHeadline}
        </p>
        <p class="text-base sm:text-lg text-muted dark:text-muted-dark mb-8 leading-relaxed max-w-2xl">
          {profile.heroSpecialization}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <ButtonLink href="/projects" variant="primary">
            Explore Projects &rarr;
          </ButtonLink>
          <ButtonLink href="/contact" variant="outline">
            Get in Touch
          </ButtonLink>
        </div>
      </div>

      <!-- Hero Right: Abstract Technical Emblem / Visual Container -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="w-full max-w-xs sm:max-w-sm rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark p-6 shadow-sm flex flex-col justify-between h-72">
          <div>
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-accent text-white flex items-center justify-center font-bold font-mono text-sm shadow">
                FH
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800/50">
                Available for roles
              </span>
            </div>
            <p class="text-sm font-bold text-primary dark:text-primary-dark mt-6 mb-1">
              Core Engineering Focus
            </p>
            <p class="text-xs text-muted dark:text-muted-dark leading-relaxed">
              C# • ASP.NET Core • Angular • PostgreSQL • SQL Server • Distributed Systems
            </p>
          </div>

          <div class="border-t border-border dark:border-border-dark pt-3 flex items-center justify-between text-xs text-muted dark:text-muted-dark font-mono">
            <span>Dhaka, Bangladesh</span>
            <span>.NET 9 / LTS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-border dark:border-border-dark" aria-labelledby="projects-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <SectionHeading
        eyebrow="PORTFOLIO"
        title="Selected Projects"
        description="Full-stack systems, architectural implementations, and database architectures with comprehensive case studies."
        class="mb-0"
      />
      <a href="/projects" class="text-sm font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded py-1 whitespace-nowrap">
        View all projects &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Experience Teaser Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-border dark:border-border-dark" aria-labelledby="experience-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <SectionHeading
        eyebrow="CAREER TIMELINE"
        title="Experience Overview"
        description="Track record building enterprise ERP systems, scalable REST APIs, and asynchronous messaging architectures."
        class="mb-0"
      />
      <a href="/experience" class="text-sm font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded py-1 whitespace-nowrap">
        Full career history &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {experiences.map((exp) => (
        <div class="p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-semibold text-accent dark:text-accent-dark px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/40">
                {exp.startDate} – {exp.endDate}
              </span>
              <span class="text-xs text-muted dark:text-muted-dark">{exp.location}</span>
            </div>
            <h3 class="text-lg font-bold text-primary dark:text-primary-dark mb-1">
              {exp.role}
            </h3>
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
              {exp.company}
            </p>
            <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-2">
              {exp.contributions[0]}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border dark:border-border-dark flex flex-wrap gap-1">
            {exp.technologies.slice(0, 4).map((tech) => (
              <span class="px-2 py-0.5 text-xs rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent Writing Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-border dark:border-border-dark" aria-labelledby="writing-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <SectionHeading
        eyebrow="TECHNICAL ARTICLES"
        title="Recent Writing"
        description="Practical engineering notes and architecture patterns written from production experience."
        class="mb-0"
      />
      <a href="/blog" class="text-sm font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded py-1 whitespace-nowrap">
        View all articles &rarr;
      </a>
    </div>

    {
      recentPosts.length === 0 ? (
        <p class="text-muted dark:text-muted-dark py-8">Articles are currently being prepared for publication.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <article class="flex flex-col justify-between p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-all hover:shadow-md">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-accent dark:text-accent-dark mb-3">
                  {post.data.category}
                </span>
                <h3 class="text-lg font-bold text-primary dark:text-primary-dark mb-2 tracking-tight">
                  <a href={`/blog/${post.id}`} class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-3 mb-4">
                  {post.data.excerpt}
                </p>
              </div>
              <div class="pt-4 border-t border-border dark:border-border-dark flex items-center justify-between text-xs text-muted dark:text-muted-dark">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <a href={`/blog/${post.id}`} class="font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded p-1">
                  Read article &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <!-- Contact CTA Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-border dark:border-border-dark">
    <div class="p-8 sm:p-12 rounded-3xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="max-w-xl">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary dark:text-primary-dark mb-2">
          Interested in working together?
        </h2>
        <p class="text-base text-muted dark:text-muted-dark leading-relaxed">
          I am currently open to full-time engineering roles, technical architecture collaborations, and discussions.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <ButtonLink href="/contact" variant="primary">
          Contact Me &rarr;
        </ButtonLink>
        <ButtonLink href="/about" variant="outline">
          Read Bio
        </ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>
