---
import { mainNavigation } from '../../data/navigation';
import ThemeToggle from '../common/ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/90 dark:bg-[#111C2D]/90 border-b border-border dark:border-border-dark transition-colors duration-200" role="banner">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-primary dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring rounded-md px-1"
      aria-label="Fuad Hasan - Home"
    >
      FUAD HASAN
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
      {
        mainNavigation.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/'
              : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-1.5 text-sm font-medium rounded-lg transition-colors focus-ring',
                isActive
                  ? 'text-accent dark:text-accent-dark bg-blue-50 dark:bg-blue-950/40 font-semibold'
                  : 'text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark hover:bg-slate-100 dark:hover:bg-slate-800/50'
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Right Actions: Theme Toggle & Resume CTA & Mobile Trigger -->
    <div class="flex items-center space-x-2">
      <a
        href="/resume/Fuad_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center text-xs font-semibold px-3 py-1.5 rounded-lg border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus-ring"
      >
        Resume PDF &nearr;
      </a>

      <ThemeToggle />

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-trigger"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-muted hover:text-primary dark:text-muted-dark dark:hover:text-primary-dark focus-ring"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-nav-dialog"
      >
        <svg
          id="hamburger-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Disclosure Navigation Panel -->
  <nav
    id="mobile-nav-dialog"
    class="hidden md:hidden border-t border-border dark:border-border-dark px-4 pt-3 pb-5 space-y-1.5 bg-surface-light dark:bg-surface-dark shadow-lg transition-all"
    aria-label="Mobile Navigation"
  >
    {
      mainNavigation.map((item) => {
        const isActive =
          item.href === '/'
            ? currentPath === '/'
            : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
        return (
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2.5 text-base font-medium rounded-lg transition-colors focus-ring',
              isActive
                ? 'text-accent dark:text-accent-dark bg-blue-50 dark:bg-blue-950/40 font-semibold'
                : 'text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark hover:bg-slate-100 dark:hover:bg-slate-800'
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
    <div class="pt-3 border-t border-border dark:border-border-dark mt-2">
      <a
        href="/resume/Fuad_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-3 py-2 text-sm font-semibold text-accent dark:text-accent-dark hover:underline"
      >
        Download Resume (PDF) &nearr;
      </a>
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-nav-dialog');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!trigger || !panel || !hamburgerIcon || !closeIcon) return;

    function openMenu() {
      panel?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
      trigger?.setAttribute('aria-label', 'Close main menu');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }

    function closeMenu() {
      panel?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.setAttribute('aria-label', 'Open main menu');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    trigger.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        trigger.focus();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        trigger.getAttribute('aria-expanded') === 'true' &&
        !panel.contains(target) &&
        !trigger.contains(target)
      ) {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
