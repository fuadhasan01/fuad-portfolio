---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { experiences } from '../data/experience';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';
import SocialLinks from '../components/common/SocialLinks.astro';

const projects = await getCollection('projects', ({ data }) => data.featured);
const blogPosts = await getCollection('blog', ({ data }) => data.published);
const recentPosts = blogPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout>
  <!-- Hero Section (Balanced 2-Column Editorial Layout) -->
  <section class="pt-8 sm:pt-10 md:pt-14 pb-12 sm:pb-16 px-6 md:px-12 max-w-6xl mx-auto" aria-label="Introduction">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Hero Left: Identity, Intro, CTAs & Social Links -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Availability Status -->
        <div class="inline-flex items-center gap-2 mb-4 font-mono text-xs sm:text-sm tracking-widest uppercase text-accent dark:text-accent-dark font-medium">
          <span class="w-2 h-2 rounded-full bg-accent dark:bg-accent-dark animate-pulse"></span>
          <span>Available for select engagements &amp; roles</span>
        </div>

        <!-- Prominent Headline Name -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.25rem] xl:text-[5.75rem] leading-[0.94] tracking-tight mb-5 text-primary dark:text-primary-dark font-serif font-normal">
          Fuad <span class="text-accent dark:text-accent-dark italic font-normal">Hasan</span>
        </h1>

        <!-- Professional Introduction -->
        <p class="text-lg sm:text-xl text-muted dark:text-muted-dark max-w-xl leading-relaxed font-light font-sans mb-6">
          Full Stack Software Engineer specializing in C#, ASP.NET Core, Angular, SQL Server, and distributed architecture. Building dependable systems that don't fall down.
        </p>

        <!-- Quick Credentials / Location -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-muted dark:text-muted-dark mb-8">
          <span class="text-primary dark:text-primary-dark font-medium">Efficient Software Solutions LTD</span>
          <span class="text-border dark:text-border-dark">•</span>
          <span>BSc in CSE • UIU (Summa / Honors)</span>
          <span class="text-border dark:text-border-dark">•</span>
          <span>Dhaka, Bangladesh</span>
        </div>

        <!-- Hero Actions: Primary CTAs + Real Brand Social Icons -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#work"
            class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-mono uppercase tracking-wider font-semibold rounded-lg bg-accent dark:bg-accent-dark text-white dark:text-[#09090E] hover:opacity-90 transition-opacity focus-ring shadow-sm"
          >
            View Work &darr;
          </a>
          <a
            href={profile.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2.5 text-xs font-mono uppercase tracking-wider font-medium rounded-lg border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring"
          >
            Download CV &nearr;
          </a>

          <!-- Social Icons (GitHub, LinkedIn, LeetCode, Email) -->
          <SocialLinks size="md" includeEmail={true} includeRss={false} />
        </div>
      </div>

      <!-- Hero Right: Profile Image Frame -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[280px] sm:max-w-xs md:max-w-sm lg:max-w-[340px] xl:max-w-[360px]">
          <!-- Glow accent in dark mode -->
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-accent/20 to-transparent dark:from-accent-dark/20 opacity-70 blur-lg transition-all duration-500"></div>

          <!-- Portrait Image Frame -->
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-xl group">
            <img
              src={profile.avatarUrl}
              alt="Portrait of Fuad Hasan"
              width="480"
              height="600"
              class="w-full h-full object-cover object-center grayscale contrast-105 group-hover:grayscale-0 transition-all duration-500"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Subtle status pill on image -->
            <div class="absolute bottom-3 left-3 right-3 p-3 rounded-xl bg-surface-light/85 dark:bg-surface-dark/85 backdrop-blur-md border border-border dark:border-border-dark flex items-center justify-between text-xs font-mono">
              <div>
                <p class="font-medium text-primary dark:text-primary-dark leading-tight">Fuad Hasan</p>
                <p class="text-[11px] text-muted dark:text-muted-dark leading-tight">Full Stack Engineer</p>
              </div>
              <span class="text-accent dark:text-accent-dark font-semibold px-2 py-0.5 rounded border border-accent/40 dark:border-accent-dark/40 text-[10px] tracking-wider uppercase">
                Available
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Metric Bento Row -->
    <div class="mt-12 sm:mt-16 border-t border-border dark:border-border-dark pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="flex flex-wrap gap-8 sm:gap-12">
        <div>
          <p class="text-2xl md:text-3xl font-serif text-primary dark:text-primary-dark">3+</p>
          <p class="text-xs text-muted dark:text-muted-dark mt-1 font-mono tracking-wide">Featured Projects</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-serif text-primary dark:text-primary-dark">2+</p>
          <p class="text-xs text-muted dark:text-muted-dark mt-1 font-mono tracking-wide">Years Experience</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-serif text-primary dark:text-primary-dark">3.6 / 4.0</p>
          <p class="text-xs text-muted dark:text-muted-dark mt-1 font-mono tracking-wide">CGPA • UIU Honors</p>
        </div>
      </div>

      <a
        href="#work"
        class="inline-flex items-center gap-2 text-sm font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors group focus-ring"
      >
        <span>See work</span>
        <span class="group-hover:translate-y-0.5 transition-transform">&darr;</span>
      </a>
    </div>
  </section>

  <!-- Selected Work Section (Interactive List Rows) -->
  <section id="work" class="py-24 px-6 md:px-12 max-w-6xl mx-auto border-t border-border dark:border-border-dark" aria-labelledby="work-heading">
    <div class="flex items-baseline justify-between mb-16">
      <div>
        <h2 id="work-heading" class="text-4xl md:text-5xl text-primary dark:text-primary-dark font-serif font-normal">
          Selected Work
        </h2>
      </div>
      <div class="flex items-center gap-6">
        <span class="text-muted dark:text-muted-dark text-sm font-mono">{projects.length} projects</span>
        <a href="/projects" class="hidden sm:inline-block text-xs font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors">
          All projects &rarr;
        </a>
      </div>
    </div>

    <!-- Project List Rows -->
    <div class="space-y-0 border-b border-border dark:border-border-dark">
      {
        projects.map((project, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div
              class="group border-t border-border dark:border-border-dark py-8 md:py-10 transition-all duration-300 hover:bg-surface-light/40 dark:hover:bg-surface-dark/40 px-4 -mx-4 rounded-lg"
              data-project-card
            >
              <div class="flex items-start gap-6 md:gap-10">
                <span class="text-muted dark:text-muted-dark font-mono text-xs pt-1.5 shrink-0">
                  {num}
                </span>

                <div class="flex-1 min-w-0">
                  <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-3">
                    <h3 class="text-2xl md:text-3xl text-primary dark:text-primary-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors font-serif font-normal">
                      <a href={`/projects/${project.id}`} class="focus-ring rounded">
                        {project.data.title}
                      </a>
                    </h3>
                    <span class="text-muted dark:text-muted-dark text-xs sm:text-sm shrink-0 font-mono">
                      {project.data.timeline || '2024'}
                    </span>
                  </div>

                  <p class="text-sm text-muted dark:text-muted-dark mb-4 max-w-2xl leading-relaxed">
                    {project.data.summary}
                  </p>

                  <div class="flex flex-wrap items-center justify-between gap-4">
                    <!-- Technology Badges -->
                    <div class="flex flex-wrap gap-2">
                      {project.data.technologies.slice(0, 5).map((tech) => (
                        <span class="text-xs px-2.5 py-0.5 border border-border dark:border-border-dark text-muted dark:text-muted-dark font-mono">
                          {tech}
                        </span>
                      ))}
                    </div>

                    <!-- Verified CTAs (FR-008: Demo link shown only when verified) -->
                    <div class="flex items-center gap-4 text-xs font-mono">
                      <a
                        href={`/projects/${project.id}`}
                        class="text-accent dark:text-accent-dark hover:underline font-medium focus-ring"
                        aria-label={`Case Study: ${project.data.title}`}
                      >
                        Case Study &rarr;
                      </a>
                      {project.data.repositoryUrl && (
                        <a
                          href={project.data.repositoryUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors focus-ring"
                          aria-label={`Source: ${project.data.title} on GitHub (opens in new tab)`}
                        >
                          Source &nearr;
                        </a>
                      )}
                      {project.data.demoUrl && (
                        <a
                          href={project.data.demoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent dark:text-accent-dark font-medium hover:underline focus-ring"
                          aria-label={`Demo: ${project.data.title} live demonstration (opens in new tab)`}
                        >
                          Demo &nearr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-24 px-6 md:px-12 max-w-6xl mx-auto border-t border-border dark:border-border-dark" aria-labelledby="about-heading">
    <div class="flex items-baseline justify-between mb-16">
      <h2 id="about-heading" class="text-4xl md:text-5xl text-primary dark:text-primary-dark font-serif font-normal">
        About
      </h2>
      <a
        href="/about"
        class="text-xs font-mono uppercase tracking-widest text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring"
      >
        Full Story &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Editorial Narrative -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <p class="text-xl md:text-2xl text-primary dark:text-primary-dark leading-relaxed mb-6 font-light font-sans">
          I build systems designed to last. My work sits at the intersection of transactional correctness, query performance, and maintainable software architecture.
        </p>
        <p class="text-sm md:text-base text-muted dark:text-muted-dark leading-relaxed mb-6 font-sans">
          My primary focus centers on modern C# and ASP.NET Core, where I design clean domain boundaries, resilient RESTful contracts, and event-driven workflows. In distributed environments, I implement asynchronous messaging and Transactional Outbox patterns with MassTransit and RabbitMQ to guarantee reliable event delivery.
        </p>
        <p class="text-sm md:text-base text-muted dark:text-muted-dark leading-relaxed font-sans">
          I hold a Bachelor of Science in Computer Science and Engineering from <strong>United International University (UIU)</strong>, graduating with a CGPA of <strong>3.6 / 4.0</strong>. I was recognized as the <strong>UIU Project Show Champion</strong> for ArtPatio and awarded the merit scholarship across 7 academic trimesters.
        </p>
      </div>

      <!-- Right: Technical Capabilities Matrix Card -->
      <div class="lg:col-span-5 p-8 rounded-2xl border border-border dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 backdrop-blur-sm">
        <h3 class="text-xs font-mono uppercase tracking-widest text-accent dark:text-accent-dark mb-6 font-medium">
          Core Domains & Skills
        </h3>

        <div class="grid grid-cols-2 gap-8">
          <div>
            <p class="text-xs text-primary dark:text-primary-dark tracking-wider uppercase mb-3 font-mono font-medium">
              Languages
            </p>
            <ul class="space-y-1.5 text-xs font-sans text-muted dark:text-muted-dark">
              <li>C# (.NET 8/9)</li>
              <li>TypeScript</li>
              <li>JavaScript</li>
              <li>SQL (T-SQL, PL/pgSQL)</li>
              <li>C++</li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-primary dark:text-primary-dark tracking-wider uppercase mb-3 font-mono font-medium">
              Backend & Arch
            </p>
            <ul class="space-y-1.5 text-xs font-sans text-muted dark:text-muted-dark">
              <li>ASP.NET Core Web API</li>
              <li>Clean Architecture & CQRS</li>
              <li>MassTransit & RabbitMQ</li>
              <li>Transactional Outbox</li>
              <li>Entity Framework Core</li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-primary dark:text-primary-dark tracking-wider uppercase mb-3 font-mono font-medium">
              Databases & Storage
            </p>
            <ul class="space-y-1.5 text-xs font-sans text-muted dark:text-muted-dark">
              <li>Microsoft SQL Server</li>
              <li>PostgreSQL</li>
              <li>Redis Distributed Caching</li>
              <li>Query Profiling & Indexing</li>
              <li>Database Migrations</li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-primary dark:text-primary-dark tracking-wider uppercase mb-3 font-mono font-medium">
              Frontend & Tools
            </p>
            <ul class="space-y-1.5 text-xs font-sans text-muted dark:text-muted-dark">
              <li>Angular & RxJS</li>
              <li>Tailwind CSS</li>
              <li>Docker & Containers</li>
              <li>Git & CI Workflows</li>
              <li>Postman & Swagger</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section (Editorial Timeline) -->
  <section id="experience" class="py-24 px-6 md:px-12 max-w-6xl mx-auto border-t border-border dark:border-border-dark" aria-labelledby="exp-heading">
    <div class="flex items-baseline justify-between mb-16">
      <h2 id="exp-heading" class="text-4xl md:text-5xl text-primary dark:text-primary-dark font-serif font-normal">
        Experience
      </h2>
      <a
        href="/resume/Fuad_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-xs sm:text-sm font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors group focus-ring"
      >
        <span>Full résumé</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&nearr;</span>
      </a>
    </div>

    <!-- Experience Timeline Rows -->
    <div class="space-y-0 border-b border-border dark:border-border-dark">
      {
        experiences.map((exp) => (
          <div class="border-t border-border dark:border-border-dark py-8 md:py-10 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-10">
            <div class="md:col-span-3">
              <p class="text-xs text-muted dark:text-muted-dark font-mono">
                {exp.startDate} — {exp.endDate}
              </p>
              <p class="text-xs text-muted dark:text-muted-dark font-mono mt-1">
                {exp.location}
              </p>
            </div>

            <div class="md:col-span-9">
              <h3 class="text-xl md:text-2xl text-primary dark:text-primary-dark mb-1 font-serif font-normal">
                {exp.role}
              </h3>
              <p class="text-accent dark:text-accent-dark text-sm mb-4 font-mono font-medium">
                {exp.company}
              </p>
              <p class="text-muted dark:text-muted-dark leading-relaxed text-sm max-w-3xl mb-4 font-sans">
                {exp.contributions[0]}
              </p>

              <div class="flex flex-wrap gap-2">
                {exp.technologies.map((tech) => (
                  <span class="text-xs px-2 py-0.5 border border-border dark:border-border-dark text-muted dark:text-muted-dark font-mono">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Technical Terminal Quote Banner -->
  <section class="py-16 px-6 md:px-12 max-w-6xl mx-auto" aria-label="Engineering Philosophy">
    <div class="bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark p-6 md:p-10 shadow-sm">
      <div class="flex items-center gap-2 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent dark:text-accent-dark">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" x2="20" y1="19" y2="19"></line>
        </svg>
        <span class="text-xs text-muted dark:text-muted-dark font-mono">fuad@workstation ~</span>
      </div>
      <p class="text-2xl md:text-3xl text-primary dark:text-primary-dark leading-relaxed font-serif italic font-normal">
        "The measure of an architecture is not how effortlessly it passes happy-path tests — it's how reliably it preserves transactional consistency, isolates failures, and recovers when the unexpected happens in production."
      </p>
    </div>
  </section>

  <!-- Recent Writing / Blog Teaser Section -->
  <section id="writing" class="py-24 px-6 md:px-12 max-w-6xl mx-auto border-t border-border dark:border-border-dark" aria-labelledby="writing-heading">
    <div class="flex items-baseline justify-between mb-16">
      <h2 id="writing-heading" class="text-4xl md:text-5xl text-primary dark:text-primary-dark font-serif font-normal">
        Writing
      </h2>
      <a href="/blog" class="text-xs font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors">
        View all articles &rarr;
      </a>
    </div>

    <div class="space-y-0 border-b border-border dark:border-border-dark">
      {
        recentPosts.map((post) => (
          <div class="group border-t border-border dark:border-border-dark py-8 transition-all duration-300 hover:bg-surface-light/40 dark:hover:bg-surface-dark/40 px-4 -mx-4 rounded-lg">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-2">
              <h3 class="text-xl md:text-2xl text-primary dark:text-primary-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors font-serif font-normal">
                <a href={`/blog/${post.id}`} class="focus-ring rounded">
                  {post.data.title}
                </a>
              </h3>
              <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-muted dark:text-muted-dark shrink-0">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="text-sm text-muted dark:text-muted-dark line-clamp-2 max-w-3xl mb-3 font-sans">
              {post.data.excerpt}
            </p>
            <div class="flex items-center gap-4 text-xs font-mono text-muted dark:text-muted-dark">
              <span class="text-accent dark:text-accent-dark font-medium">{post.data.category}</span>
              <span>•</span>
              <span>{getReadingTime(post.body || '').text}</span>
              <span>•</span>
              <a href={`/blog/${post.id}`} class="text-accent dark:text-accent-dark hover:underline">
                Read article &rarr;
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact & Call to Action (Matching Reference Headline & Form Layout) -->
  <section id="contact" class="py-24 px-6 md:px-12 max-w-6xl mx-auto border-t border-border dark:border-border-dark" aria-labelledby="contact-heading">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
      <div>
        <h2 id="contact-heading" class="text-4xl md:text-6xl text-primary dark:text-primary-dark mb-6 leading-tight font-serif font-normal">
          Let's build something worth building.
        </h2>
        <p class="text-muted dark:text-muted-dark leading-relaxed mb-8 font-sans">
          I am currently open to full-time engineering roles, technical architecture collaborations, and discussions. Reach out through the channels below.
        </p>

        <div class="space-y-3 font-mono text-xs">
          <div class="flex items-center gap-4">
            <span class="text-muted dark:text-muted-dark w-16 shrink-0 uppercase tracking-wider">Email</span>
            <a href="mailto:contact@fuadhasan.dev" class="text-sm text-primary dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring">
              contact@fuadhasan.dev
            </a>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-muted dark:text-muted-dark w-16 shrink-0 uppercase tracking-wider">GitHub</span>
            <a href="https://github.com/fuadhasan01" target="_blank" rel="noopener noreferrer" class="text-sm text-primary dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring">
              github.com/fuadhasan01
            </a>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-muted dark:text-muted-dark w-16 shrink-0 uppercase tracking-wider">LinkedIn</span>
            <a href="https://linkedin.com/in/fuadhasan01" target="_blank" rel="noopener noreferrer" class="text-sm text-primary dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring">
              linkedin.com/in/fuadhasan01
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Message Action Card (Matching Reference Mail Card) -->
      <div class="p-8 bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark flex flex-col justify-between gap-6 shadow-sm">
        <div>
          <span class="text-xs font-mono text-accent dark:text-accent-dark uppercase tracking-widest block mb-2 font-medium">
            Fast Response
          </span>
          <h3 class="text-2xl font-serif text-primary dark:text-primary-dark font-normal mb-2">
            Direct Engineering Inquiry
          </h3>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed font-sans">
            Need an engineer for high-performance C# / .NET backends, distributed messaging, or structured Angular web applications?
          </p>
        </div>

        <div class="space-y-3">
          <a
            href="mailto:contact@fuadhasan.dev?subject=Engineering%20Inquiry%20-%20Fuad%20Hasan"
