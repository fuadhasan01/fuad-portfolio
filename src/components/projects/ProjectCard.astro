---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  category,
  technologies,
  cover,
  coverAlt,
  repositoryUrl,
  demoUrl
} = project.data;
---

<article
  class="flex flex-col justify-between border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-300 group h-full shadow-sm"
  data-category={category}
  data-technologies={technologies.join(',')}
  data-project-card
>
  <div>
    <!-- Project Thumbnail / Visual Container -->
    <a
      href={`/projects/${project.id}`}
      class="block aspect-[16/10] overflow-hidden bg-slate-900 border-b border-border dark:border-border-dark focus-ring"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={cover}
        alt={coverAlt}
        width="600"
        height="375"
        class="w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
        loading="lazy"
      />
    </a>

    <div class="p-6">
      <!-- Category Badge -->
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-mono font-medium px-2.5 py-0.5 border border-border dark:border-border-dark text-accent dark:text-accent-dark">
          {category}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-2xl font-serif font-normal text-primary dark:text-primary-dark mb-2 tracking-tight">
        <a
          href={`/projects/${project.id}`}
          class="hover:text-accent dark:hover:text-accent-dark focus-ring rounded inline-block"
        >
          {title}
        </a>
      </h3>

      <!-- Summary -->
      <p class="text-sm text-muted dark:text-muted-dark leading-relaxed line-clamp-3 mb-4 font-sans">
        {summary}
      </p>

      <!-- Technology Pills -->
      <div class="flex flex-wrap gap-1.5" aria-label="Technologies used">
        {technologies.slice(0, 4).map((tech) => (
          <span class="px-2 py-0.5 text-xs font-mono border border-border dark:border-border-dark text-muted dark:text-muted-dark">
            {tech}
          </span>
        ))}
        {technologies.length > 4 && (
          <span class="px-2 py-0.5 text-xs font-mono text-muted dark:text-muted-dark">
            +{technologies.length - 4}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Action Links Footer -->
  <div class="px-6 py-4 border-t border-border dark:border-border-dark flex items-center justify-between font-mono text-xs">
    <a
      href={`/projects/${project.id}`}
      class="text-accent dark:text-accent-dark font-medium hover:underline focus-ring rounded"
      aria-label={`Case Study: ${title}`}
    >
      Case Study &rarr;
    </a>

    <div class="flex items-center space-x-3 text-xs">
      {repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark focus-ring rounded p-1 transition-colors"
          aria-label={`Source: ${title} on GitHub (opens in new tab)`}
        >
          Source &nearr;
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent dark:text-accent-dark font-medium hover:underline focus-ring rounded p-1"
          aria-label={`Demo: ${title} live demonstration (opens in new tab)`}
        >
          Demo &nearr;
        </a>
      )}
    </div>
  </div>
</article>
