---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  id?: string;
}

const { eyebrow, title, description, class: className = '', id } = Astro.props;
---

<div class:list={['mb-8', className]}>
  {eyebrow && (
    <span class="text-xs font-semibold tracking-wider text-accent dark:text-accent-dark uppercase block mb-1">
      {eyebrow}
    </span>
  )}
  <h2 id={id} class="text-2xl sm:text-3xl font-bold tracking-tight text-primary dark:text-primary-dark">
    {title}
  </h2>
  {description && (
    <p class="text-base text-muted dark:text-muted-dark mt-2 leading-relaxed max-w-2xl">
      {description}
    </p>
  )}
</div>
