---
interface Props {
  categories: string[];
  totalCount: number;
}

const { categories, totalCount } = Astro.props;
---

<div class="mb-12" role="region" aria-label="Search and filter articles">
  <!-- Search Input Container -->
  <div class="mb-6 max-w-xl">
    <label for="blog-search-input" class="sr-only">Search articles by title, topic, or tag</label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted dark:text-muted-dark">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="blog-search-input"
        class="w-full pl-10 pr-10 py-3 text-xs font-mono rounded-xl border border-border dark:border-border-dark bg-surface-light dark:bg-surface-dark text-primary dark:text-primary-dark placeholder-muted dark:placeholder-muted-dark focus:outline-none focus:ring-1 focus:ring-accent dark:focus:ring-accent-dark transition-all"
        placeholder="Search articles by keyword, technology, or topic..."
        autocomplete="off"
      />
      <button
        type="button"
        id="blog-search-clear"
        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark hidden focus-ring rounded"
        aria-label="Clear search input"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Filter Pills Bar & Counter -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-mono text-xs">
    <!-- Category Pills -->
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter articles by category">
      <button
        type="button"
        class="blog-category-pill px-3 py-1 text-xs font-mono transition-colors focus-ring border border-accent dark:border-accent-dark text-accent dark:text-accent-dark bg-transparent font-medium"
        data-category="all"
        aria-pressed="true"
      >
        All Topics
      </button>
      {
        categories.map((cat) => (
          <button
            type="button"
            class="blog-category-pill px-3 py-1 text-xs font-mono transition-colors focus-ring border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:border-primary dark:hover:border-primary-dark hover:text-primary dark:hover:text-primary-dark"
            data-category={cat}
            aria-pressed="false"
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Live Results Counter -->
    <div
      id="blog-filter-count"
      class="text-xs text-muted dark:text-muted-dark whitespace-nowrap font-mono"
      aria-live="polite"
    >
      Showing <span id="blog-visible-count" class="font-semibold text-primary dark:text-primary-dark">{totalCount}</span> of {totalCount} articles
    </div>
  </div>
</div>

<script>
  function setupBlogFilters() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('blog-search-clear') as HTMLButtonElement | null;
    const pills = document.querySelectorAll<HTMLButtonElement>('.blog-category-pill');
    const cards = document.querySelectorAll<HTMLElement>('[data-blog-card]');
    const countSpan = document.getElementById('blog-visible-count');
    const emptyState = document.getElementById('blog-empty-state');
    const resetBtn = document.getElementById('blog-empty-reset-btn');

    if (!cards.length) return;

    let activeCategory = 'all';
    let searchQuery = '';

    function filterCards() {
      let visible = 0;
      const query = searchQuery.trim().toLowerCase();

      cards.forEach((card) => {
        const cardCat = (card.getAttribute('data-category') || '').trim();
        const cardTitle = (card.getAttribute('data-title') || '').trim();
        const cardExcerpt = (card.getAttribute('data-excerpt') || '').trim();
        const cardTags = (card.getAttribute('data-tags') || '').trim();

        const categoryMatches = activeCategory === 'all' || cardCat.toLowerCase() === activeCategory.toLowerCase();
        
        const searchMatches =
          !query ||
          cardTitle.includes(query) ||
          cardExcerpt.includes(query) ||
          cardTags.includes(query) ||
          cardCat.toLowerCase().includes(query);

        if (categoryMatches && searchMatches) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countSpan) {
        countSpan.textContent = visible.toString();
      }

      if (emptyState) {
        if (visible === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    function updatePills(selectedCategory: string) {
      activeCategory = selectedCategory;
      pills.forEach((pill) => {
        const cat = pill.getAttribute('data-category') || 'all';
        const isActive = cat.toLowerCase() === selectedCategory.toLowerCase();
        pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          pill.className = 'blog-category-pill px-3 py-1 text-xs font-mono transition-colors focus-ring border border-accent dark:border-accent-dark text-accent dark:text-accent-dark bg-transparent font-medium';
        } else {
          pill.className = 'blog-category-pill px-3 py-1 text-xs font-mono transition-colors focus-ring border border-border dark:border-border-dark text-muted dark:text-muted-dark hover:border-primary dark:hover:border-primary-dark hover:text-primary dark:hover:text-primary-dark';
        }
      });
      filterCards();
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        if (clearBtn) {
          if (searchQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterCards();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.classList.add('hidden');
        filterCards();
        searchInput.focus();
      });
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category') || 'all';
        updatePills(cat);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        if (clearBtn) clearBtn.classList.add('hidden');
        updatePills('all');
      });
    }
  }

  setupBlogFilters();
  document.addEventListener('astro:page-load', setupBlogFilters);
</script>
