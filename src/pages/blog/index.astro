---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogFilter from '../../components/blog/BlogFilter.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import { getCollection } from 'astro:content';

// Only retrieve published blog articles
const publishedPosts = await getCollection('blog', ({ data }) => data.published);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Compute unique categories present in published posts
const categories = Array.from(new Set(sortedPosts.map((p) => p.data.category))).sort();
---

<BaseLayout
  title="Technical Blog & Engineering Notes | Fuad Hasan"
  description="Practical articles on ASP.NET Core, CQRS, transactional outbox patterns, and high-performance database optimization by Fuad Hasan."
  wide={true}
>
  <div>
    <!-- Header -->
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl sm:text-4xl font-heading font-bold tracking-tight text-heading mb-2.5">
        Technical Writing &amp; Notes
      </h1>

      <p class="text-sm sm:text-base text-muted leading-relaxed font-sans">
        Practical guides, architectural patterns, and production lessons on .NET 9, distributed systems, clean architecture, and SQL database tuning.
      </p>
    </header>

    <!-- Search & Category Filter Island -->
    <BlogFilter categories={categories} totalCount={sortedPosts.length} />

    <!-- Articles Grid -->
    <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="blog-empty-state" class="hidden mt-8">
      <EmptyState
        title="No matching articles found"
        message="No published articles match your current search query or category filter. Try clearing the search or choosing another topic."
        resetText="Show All Articles"
        resetId="blog-empty-reset-btn"
      />
    </div>
  </div>
</BaseLayout>
