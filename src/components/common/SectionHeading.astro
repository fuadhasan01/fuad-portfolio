---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  id?: string;
}

const { eyebrow, title, description, class: className = '', id } = Astro.props;
---

<div class:list={['mb-10', className]}>
  {eyebrow && (
    <span class="font-mono text-xs font-medium tracking-widest text-accent dark:text-accent-dark uppercase block mb-2">
      {eyebrow}
    </span>
  )}
  <h2 id={id} class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-primary dark:text-primary-dark leading-tight">
    {title}
  </h2>
  {description && (
    <p class="text-base sm:text-lg text-muted dark:text-muted-dark mt-3 leading-relaxed max-w-2xl font-sans">
      {description}
    </p>
  )}
</div>
