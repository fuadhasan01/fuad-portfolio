---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  id?: string;
}

const { eyebrow, title, description, class: className = '', id } = Astro.props;
---

<div class:list={['mb-8', className]}>
  {eyebrow && (
    <span class="font-mono text-xs font-semibold text-accent uppercase tracking-wider block mb-1.5">
      {eyebrow}
    </span>
  )}
  <h2 id={id} class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-heading">
    {title}
  </h2>
  {description && (
    <p class="text-sm sm:text-base text-muted mt-2 leading-relaxed max-w-2xl font-sans">
      {description}
    </p>
  )}
</div>
