---
import type { ExperienceItem } from '../../data/experience';

interface Props {
  items: ExperienceItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<ol class="relative border-l border-border dark:border-border-dark ml-3 space-y-10" role="list">
  {
    items.map((item) => (
      <li class="mb-10 ml-6">
        <span class="absolute flex items-center justify-center w-6 h-6 rounded-full -left-3 bg-canvas-light dark:bg-canvas-dark border border-border dark:border-border-dark">
          <span class="w-2 h-2 rounded-full bg-accent dark:bg-accent-dark"></span>
        </span>
        <div class="p-6 sm:p-8 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border dark:border-border-dark">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <h3 class="font-serif text-xl sm:text-2xl font-normal text-primary dark:text-primary-dark">
              {item.role}
            </h3>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded font-mono text-xs font-medium border border-accent/40 dark:border-accent-dark/40 text-accent dark:text-accent-dark w-fit">
              <time>{item.startDate}</time> &ndash; <time>{item.endDate}</time>
            </span>
          </div>
          <p class="text-sm font-sans text-muted dark:text-muted-dark mb-5">
            <span class="font-semibold text-primary dark:text-primary-dark">{item.company}</span> &bull; <span>{item.location}</span>
          </p>

          {!compact && (
            <div class="mb-6">
              <h4 class="font-mono text-xs uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
                Verified Responsibilities
              </h4>
              <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300 list-disc list-inside">
                {item.contributions.map((c) => (
                  <li class="leading-relaxed">{c}</li>
                ))}
              </ul>
            </div>
          )}

          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-border dark:border-border-dark" aria-label="Technologies used">
            {item.technologies.map((tech) => (
              <span class="px-2 py-0.5 font-mono text-xs rounded border border-border dark:border-border-dark text-muted dark:text-muted-dark bg-secondary-light/30 dark:bg-secondary-dark/30">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ol>
