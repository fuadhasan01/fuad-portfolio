---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  category,
  technologies,
  cover,
  coverAlt,
  repositoryUrl,
  frontendRepositoryUrl,
  demoUrl,
  role,
  timeline,
  status
} = project.data;
---

<BaseLayout
  title={`${title} - Case Study | Fuad Hasan`}
  description={summary}
  image={cover}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-sm text-muted dark:text-muted-dark mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring rounded">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/projects" class="hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring rounded">Projects</a>
      <span aria-hidden="true">/</span>
      <span class="text-primary dark:text-primary-dark font-medium truncate" aria-current="page">{title}</span>
    </nav>

    <!-- Case Study Split Hero Section (wireframe_project.png) -->
    <header class="mb-14 pb-10 border-b border-border dark:border-border-dark">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Overview & Action Column (Left) -->
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-4 font-mono text-xs">
            <span class="font-medium tracking-widest text-accent dark:text-accent-dark uppercase">
              Project Case Study
            </span>
            <span class="text-muted dark:text-muted-dark" aria-hidden="true">•</span>
            <span class="px-2.5 py-0.5 border border-border dark:border-border-dark text-muted dark:text-muted-dark">
              {category}
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal tracking-tight text-primary dark:text-primary-dark mb-4">
            {title}
          </h1>

          <p class="text-base sm:text-lg text-muted dark:text-muted-dark leading-relaxed mb-8 font-sans">
            {summary}
          </p>

          <!-- Metadata Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 py-4 border-y border-border dark:border-border-dark mb-8 text-xs font-mono">
            <div>
              <span class="block text-muted dark:text-muted-dark uppercase tracking-wider mb-1">Role</span>
              <span class="font-medium text-primary dark:text-primary-dark text-sm">{role}</span>
            </div>
            {timeline && (
              <div>
                <span class="block text-muted dark:text-muted-dark uppercase tracking-wider mb-1">Timeline</span>
                <span class="font-medium text-primary dark:text-primary-dark text-sm">{timeline}</span>
              </div>
            )}
            <div>
              <span class="block text-muted dark:text-muted-dark uppercase tracking-wider mb-1">Status</span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-emerald-800 dark:text-emerald-300 capitalize text-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
                {status}
              </span>
            </div>
          </div>

          <!-- Technologies Badges -->
          <div class="mb-8">
            <span class="sr-only">Technologies used:</span>
            <div class="flex flex-wrap gap-2">
              {
                technologies.map((tech) => (
                  <span class="px-2.5 py-0.5 text-xs font-mono border border-border dark:border-border-dark text-muted dark:text-muted-dark">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Action Buttons (FR-008: Source & Demo links shown only when verified) -->
          <div class="flex flex-wrap gap-3 font-mono text-xs">
            {
              repositoryUrl && (
                <a
                  href={repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-3 font-semibold uppercase tracking-wider border border-accent dark:border-accent-dark text-accent dark:text-accent-dark hover:bg-accent dark:hover:bg-accent-dark hover:text-white dark:hover:text-[#09090E] transition-all duration-200 shadow-sm focus-ring"
                  aria-label={`${frontendRepositoryUrl ? 'Backend Repo' : 'View Repository'}: ${title} on GitHub (opens in new tab)`}
                >
                  <span>{frontendRepositoryUrl ? 'Backend Repo' : 'View Repository'} &rarr;</span>
                </a>
              )
            }
            {
              frontendRepositoryUrl && (
                <a
                  href={frontendRepositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-3 font-semibold uppercase tracking-wider border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-primary dark:hover:border-primary-dark transition-colors focus-ring"
                  aria-label={`Frontend Repo: ${title} on GitHub (opens in new tab)`}
                >
                  <span>Frontend Repo &rarr;</span>
                </a>
              )
            }
            {
              demoUrl && (
                <a
                  href={demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-5 py-3 font-semibold uppercase tracking-wider border border-border dark:border-border-dark text-primary dark:text-primary-dark hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring"
                  aria-label={`Live Demo: ${title} (opens in new tab)`}
                >
                  <span>Live Demo</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              )
            }
          </div>
        </div>

        <!-- Cover Preview Container (Right) -->
        <div class="lg:col-span-5">
          <figure class="relative overflow-hidden border border-border dark:border-border-dark shadow-sm bg-slate-900 group">
            <img
              src={cover}
              alt={coverAlt}
              width="800"
              height="480"
              class="w-full h-auto object-cover transform transition-transform duration-300 group-hover:scale-[1.02]"
              loading="eager"
            />
            <figcaption class="p-3 text-center text-xs text-slate-400 bg-slate-900/90 border-t border-slate-800">
              {coverAlt}
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- Case Study Body (Prose) -->
    <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-accent dark:prose-a:text-accent-dark hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-border dark:prose-img:border-border-dark">
      <slot />
    </article>

    <!-- Back to projects footer -->
    <div class="mt-14 pt-8 border-t border-border dark:border-border-dark flex items-center justify-between">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent dark:text-accent-dark hover:underline focus-ring rounded"
      >
        <span aria-hidden="true">&larr;</span> Back to all projects
      </a>
      <a
        href="#top"
        class="text-xs text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors focus-ring rounded"
      >
        Back to top &uarr;
      </a>
    </div>
  </div>
</BaseLayout>
