---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { experiences } from '../data/experience';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';
import SocialLinks from '../components/common/SocialLinks.astro';

const projects = await getCollection('projects', ({ data }) => data.featured);
const blogPosts = await getCollection('blog', ({ data }) => data.published);
const recentPosts = blogPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout>
  <!-- Hero Section: Compact Personal Introduction -->
  <section class="pb-12 border-b border-border" aria-label="Introduction">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Hero Left: Identity, Position, Scope & CTAs -->
      <div class="md:col-span-8 flex flex-col justify-center">
        <!-- Availability & Engineering Status Note -->
        <div class="inline-flex items-center gap-2 mb-3 text-xs font-mono tracking-wider uppercase text-muted">
          <span class="w-2 h-2 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
          <span>Available for select engagements &amp; roles</span>
        </div>

        <!-- Prominent Headline Name & Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold tracking-tight mb-3 text-heading">
          Fuad Hasan
        </h1>

        <p class="text-lg sm:text-xl text-accent font-heading font-semibold mb-3 leading-snug">
          Building resilient systems that don't fall down.
        </p>

        <!-- Professional Narrative -->
        <p class="text-sm sm:text-base text-body max-w-xl leading-relaxed font-sans mb-4">
          Full Stack Software Engineer focused on C#, ASP.NET Core, Angular, SQL Server, and distributed systems. Specializing in transactional consistency, query performance profiling, and maintainable domain architecture.
        </p>

        <!-- Academic & Location Credentials -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-muted mb-6">
          <span class="text-heading font-medium">BSc in CSE • UIU (Summa / Honors)</span>
          <span class="text-border" aria-hidden="true">•</span>
          <span>Dhaka, Bangladesh</span>
          <span class="text-border" aria-hidden="true">•</span>
          <span class="text-accent font-medium">Lead Engineer @ ESS</span>
        </div>

        <!-- Actions: Primary CTAs + Brand Social Links -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#work"
            class="btn-primary"
          >
            View Work &darr;
          </a>
          <a
            href={profile.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Download CV &nearr;
          </a>

          <!-- Social Icons (GitHub, LinkedIn, LeetCode, Email) -->
          <SocialLinks size="sm" includeEmail={true} includeRss={false} />
        </div>
      </div>

      <!-- Hero Right: Profile Image Frame (Two-column desktop balance) -->
      <div class="md:col-span-4 flex justify-center md:justify-end">
        <div class="w-full max-w-[200px] sm:max-w-[220px]">
          <div class="aspect-[4/5] rounded-lg overflow-hidden border border-border-card bg-surface shadow-sm">
            <img
              src={profile.avatarUrl}
              alt="Portrait of Fuad Hasan"
              width="440"
              height="550"
              class="w-full h-full object-cover object-center"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px] font-mono text-muted px-0.5">
            <span>FUAD HASAN</span>
            <span>DHAKA, BD</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Architectural Capability Ledger -->
    <div class="mt-10 pt-6 border-t border-border">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
        <div>
          <p class="text-xs font-mono uppercase text-accent font-semibold tracking-wider mb-1">Distributed Systems</p>
          <p class="text-xs sm:text-sm font-sans text-body">Transactional Outbox, MassTransit, RabbitMQ</p>
        </div>
        <div>
          <p class="text-xs font-mono uppercase text-accent font-semibold tracking-wider mb-1">Database Tuning</p>
          <p class="text-xs sm:text-sm font-sans text-body">SQL Server, PostgreSQL, Query Profiling &amp; Indexing</p>
        </div>
        <div>
          <p class="text-xs font-mono uppercase text-accent font-semibold tracking-wider mb-1">Domain Architecture</p>
          <p class="text-xs sm:text-sm font-sans text-body">Clean Architecture, CQRS, Modular Core</p>
        </div>
        <div>
          <p class="text-xs font-mono uppercase text-accent font-semibold tracking-wider mb-1">Frontend Contracts</p>
          <p class="text-xs sm:text-sm font-sans text-body">Angular, Strict TypeScript, Reactive RxJS</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section id="work" class="py-12 border-b border-border" aria-labelledby="work-heading">
    <div class="flex items-baseline justify-between mb-8">
      <h2 id="work-heading" class="text-2xl sm:text-3xl text-heading font-heading font-bold">
        Selected Systems &amp; Case Studies
      </h2>
      <a href="/projects" class="text-xs font-mono text-accent hover:underline">
        All projects &rarr;
      </a>
    </div>

    <!-- Project List Rows -->
    <div class="divide-y divide-border border-y border-border">
      {
        projects.map((project, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <article class="py-6 transition-colors hover:bg-alt/40 px-2 -mx-2 rounded-lg" data-project-card>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
                <!-- Index & Timeline -->
                <div class="md:col-span-2 flex items-baseline gap-2.5 text-xs font-mono text-muted">
                  <span class="font-bold text-accent">{num}</span>
                  <span>{project.data.timeline || '2024'}</span>
                </div>

                <!-- Main Content -->
                <div class="md:col-span-7">
                  <h3 class="text-lg sm:text-xl font-heading font-bold text-heading mb-1.5">
                    <a href={`/projects/${project.id}`} class="hover:text-accent transition-colors focus-ring rounded">
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="text-sm text-body mb-3 leading-relaxed font-sans">
                    {project.data.summary}
                  </p>
                  <!-- Technical Stack Tags -->
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.technologies.slice(0, 5).map((tech) => (
                      <span class="chip-tag text-[11px] py-0.5 px-2">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Actions -->
                <div class="md:col-span-3 flex md:flex-col items-center md:items-end justify-between md:justify-start gap-2 font-mono text-xs">
                  <a
                    href={`/projects/${project.id}`}
                    class="text-accent font-medium hover:underline focus-ring"
                    aria-label={`Read Case Study: ${project.data.title}`}
                  >
                    <span>Read Case Study</span> <span aria-hidden="true">&rarr;</span>
                  </a>
                  {project.data.repositoryUrl && (
                    <a
                      href={project.data.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted hover:text-heading transition-colors focus-ring"
                      aria-label={`Source Code: ${project.data.title} on GitHub (opens in new tab)`}
                    >
                      <span>Source Code</span> <span aria-hidden="true">&nearr;</span>
                    </a>
                  )}
                  {project.data.demoUrl && (
                    <a
                      href={project.data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted hover:text-heading transition-colors focus-ring"
                      aria-label={`Live Demo: ${project.data.title} (opens in new tab)`}
                    >
                      <span>Live Demo</span> <span aria-hidden="true">&nearr;</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- About Section: Engineering Scope & Core Domains -->
  <section id="about" class="py-12 border-b border-border" aria-labelledby="about-heading">
    <div class="flex items-baseline justify-between mb-8">
      <h2 id="about-heading" class="text-2xl sm:text-3xl text-heading font-heading font-bold">
        Engineering Philosophy
      </h2>
      <a
        href="/about"
        class="text-xs font-mono text-accent hover:underline focus-ring"
      >
        Full Story &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Left: Editorial Narrative -->
      <div class="md:col-span-7 space-y-4 text-body font-sans leading-relaxed text-sm sm:text-base">
        <p class="text-base sm:text-lg text-heading font-medium leading-relaxed">
          I build systems designed to last. My work centers on the intersection of transactional correctness, query performance, and domain clarity.
        </p>
        <p>
          My daily focus centers on modern C# and ASP.NET Core, where I design clean domain boundaries, resilient RESTful contracts, and event-driven workflows. In distributed environments, I implement asynchronous messaging and Transactional Outbox patterns with MassTransit and RabbitMQ to guarantee reliable event delivery.
        </p>
        <p>
          I hold a Bachelor of Science in Computer Science and Engineering from <strong>United International University (UIU)</strong>, graduating with a CGPA of <strong>3.6 / 4.0</strong>. I was recognized as the <strong>UIU Project Show Champion</strong> for ArtPatio and awarded the merit scholarship across 7 academic trimesters.
        </p>
      </div>

      <!-- Right: Technical Capabilities Grid -->
      <div class="md:col-span-5 p-5 rounded-lg border border-border-card bg-surface">
        <p class="text-xs font-mono uppercase tracking-wider text-accent mb-3 font-semibold">
          Core Domains &amp; Competencies
        </p>

        <div class="space-y-3.5 text-xs font-mono">
          <div>
            <p class="text-heading font-semibold uppercase mb-0.5">Languages</p>
            <p class="text-muted font-sans text-xs">C# (.NET 8/9), TypeScript, JavaScript, SQL (T-SQL, PL/pgSQL), C++</p>
          </div>
          <div>
            <p class="text-heading font-semibold uppercase mb-0.5">Backend &amp; Architecture</p>
            <p class="text-muted font-sans text-xs">ASP.NET Core Web API, Clean Architecture, CQRS, MassTransit, RabbitMQ, Transactional Outbox, EF Core</p>
          </div>
          <div>
            <p class="text-heading font-semibold uppercase mb-0.5">Databases &amp; Storage</p>
            <p class="text-muted font-sans text-xs">Microsoft SQL Server, PostgreSQL, Redis Caching, Query Profiling &amp; Index Optimization</p>
          </div>
          <div>
            <p class="text-heading font-semibold uppercase mb-0.5">Frontend &amp; Platform</p>
            <p class="text-muted font-sans text-xs">Angular, RxJS, Tailwind CSS, Docker, CI/CD Workflows, Postman</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Authoritative Architecture Statement -->
  <section class="py-10 border-b border-border" aria-label="Architecture Principle">
    <blockquote class="border border-border bg-alt p-6 sm:p-8 rounded-lg">
      <p class="text-base sm:text-lg text-heading font-heading font-medium leading-relaxed mb-3">
        "The measure of an architecture is not how effortlessly it passes happy-path tests — it's how reliably it preserves transactional consistency, isolates failures, and recovers when the unexpected happens in production."
      </p>
      <footer class="text-xs font-mono text-muted uppercase tracking-wider">
        &mdash; Fuad Hasan, On System Dependability
      </footer>
    </blockquote>
  </section>

  <!-- Experience Section: Career Ledger -->
  <section id="experience" class="py-12 border-b border-border" aria-labelledby="exp-heading">
    <div class="flex items-baseline justify-between mb-8">
      <h2 id="exp-heading" class="text-2xl sm:text-3xl text-heading font-heading font-bold">
        Professional Experience
      </h2>
      <a
        href="/resume/Fuad_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-accent hover:underline focus-ring"
      >
        Full résumé &nearr;
      </a>
    </div>

    <div class="divide-y divide-border border-y border-border">
      {
        experiences.map((exp) => (
          <div class="py-6 grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-3 text-xs font-mono text-muted">
              <p class="font-medium text-heading">{exp.startDate} &mdash; {exp.endDate}</p>
              <p class="mt-0.5">{exp.location}</p>
            </div>

            <div class="md:col-span-9">
              <h3 class="text-lg sm:text-xl text-heading font-heading font-bold mb-1">
                {exp.role}
              </h3>
              <p class="text-accent text-sm font-mono font-medium mb-2.5">
                {exp.company}
              </p>
              <p class="text-body leading-relaxed text-sm mb-3 font-sans">
                {exp.contributions[0]}
              </p>
              <div class="flex flex-wrap gap-1.5 pt-2">
                {exp.technologies.map((tech) => (
                  <span class="chip-tag text-[11px] py-0.5 px-2">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Technical Writing / Recent Articles -->
  <section id="writing" class="py-12 border-b border-border" aria-labelledby="writing-heading">
    <div class="flex items-baseline justify-between mb-8">
      <h2 id="writing-heading" class="text-2xl sm:text-3xl text-heading font-heading font-bold">
        Technical Writing &amp; Notes
      </h2>
      <a href="/blog" class="text-xs font-mono text-accent hover:underline">
        All articles &rarr;
      </a>
    </div>

    <div class="divide-y divide-border border-y border-border">
      {
        recentPosts.map((post) => (
          <article class="py-5 transition-colors hover:bg-alt/40 px-2 -mx-2 rounded-lg">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
              <h3 class="text-base sm:text-lg font-heading font-bold text-heading">
                <a href={`/blog/${post.id}`} class="hover:text-accent transition-colors focus-ring rounded">
                  {post.data.title}
                </a>
              </h3>
              <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-muted shrink-0">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="text-sm text-body line-clamp-2 mb-2 font-sans">
              {post.data.excerpt}
            </p>
            <div class="flex items-center gap-3 text-xs font-mono text-muted">
              <span class="text-accent font-medium">{post.data.category}</span>
              <span aria-hidden="true">•</span>
              <span>{getReadingTime(post.body || '').text}</span>
              <span aria-hidden="true">•</span>
              <a href={`/blog/${post.id}`} class="text-accent hover:underline">
                Read article &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Contact & Collaboration Hub -->
  <section id="contact" class="py-12" aria-labelledby="contact-heading">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div>
        <h2 id="contact-heading" class="text-2xl sm:text-3xl font-heading font-bold text-heading mb-3 leading-tight">
          Let's discuss architecture and engineering.
        </h2>
        <p class="text-body leading-relaxed mb-6 font-sans text-sm sm:text-base">
          I am currently open to full-time engineering roles, technical architecture collaborations, and distributed systems discussions.
        </p>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="flex items-center gap-4">
            <span class="text-muted w-16 shrink-0 uppercase tracking-wider">Email</span>
            <a href="mailto:contact@fuadhasan.dev" class="text-sm text-heading hover:text-accent transition-colors focus-ring font-sans">
              contact@fuadhasan.dev
            </a>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-muted w-16 shrink-0 uppercase tracking-wider">GitHub</span>
            <a href="https://github.com/fuadhasan01" target="_blank" rel="noopener noreferrer" class="text-sm text-heading hover:text-accent transition-colors focus-ring font-sans">
              github.com/fuadhasan01
            </a>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-muted w-16 shrink-0 uppercase tracking-wider">LinkedIn</span>
            <a href="https://linkedin.com/in/fuadhasan01" target="_blank" rel="noopener noreferrer" class="text-sm text-heading hover:text-accent transition-colors focus-ring font-sans">
              linkedin.com/in/fuadhasan01
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Message Action Panel -->
      <div class="p-6 bg-surface border border-border-card rounded-lg flex flex-col justify-between gap-5 shadow-sm">
        <div>
          <h3 class="text-base font-heading font-bold text-heading mb-1.5">
            Direct Engineering Inquiry
          </h3>
          <p class="text-sm text-body leading-relaxed font-sans">
            Need an engineer for high-performance C# / .NET backends, distributed messaging, or structured Angular web applications?
          </p>
        </div>

        <div class="space-y-2.5">
          <a
            href="mailto:contact@fuadhasan.dev?subject=Engineering%20Inquiry%20-%20Fuad%20Hasan"
            class="w-full btn-primary text-center"
          >
            Send Email (mailto) &rarr;
          </a>
          <a
            href="/contact"
            class="w-full btn-secondary text-center"
          >
            View Full Contact Information
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
