---
import { mainNavigation } from '../../data/navigation';
import ThemeToggle from '../common/ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-canvas-light/90 dark:bg-canvas-dark/90 border-b border-border dark:border-border-dark transition-colors duration-200" role="banner">
  <div class="max-w-6xl mx-auto px-6 md:px-12 h-16 flex items-center justify-between">
    <!-- Brand / Identity -->
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-base font-bold tracking-tight text-primary dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors focus-ring px-1"
    >
      <span class="w-2 h-2 rounded-sm bg-accent dark:bg-accent-dark shrink-0" aria-hidden="true"></span>
      <span>Fuad Hasan</span>
      <span class="hidden lg:inline text-xs font-mono font-normal text-muted dark:text-muted-dark border-l border-border dark:border-border-dark pl-2.5">
        Systems &amp; Full Stack
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Main Navigation">
      {
        mainNavigation.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/'
              : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                'text-sm font-sans tracking-normal transition-colors focus-ring py-1 relative',
                isActive
                  ? 'text-primary dark:text-primary-dark font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-accent dark:after:bg-accent-dark'
                  : 'text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark'
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Right Actions: Theme Toggle & Get in Touch CTA & Mobile Trigger -->
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center justify-center text-xs font-mono uppercase tracking-wider px-3.5 py-1.5 rounded border border-accent dark:border-accent-dark text-accent dark:text-accent-dark hover:bg-accent hover:text-white dark:hover:bg-accent-dark dark:hover:text-canvas-dark transition-all duration-150 font-semibold focus-ring"
      >
        Get in Touch
      </a>

      <ThemeToggle />

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-trigger"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded text-muted hover:text-primary dark:text-muted-dark dark:hover:text-primary-dark focus-ring"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-nav-dialog"
      >
        <svg
          id="hamburger-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Disclosure Navigation Panel -->
  <nav
    id="mobile-nav-dialog"
    class="hidden md:hidden border-t border-border dark:border-border-dark px-6 pt-4 pb-6 space-y-2 bg-surface-light dark:bg-surface-dark shadow-xl transition-all"
    aria-label="Mobile Navigation"
  >
    {
      mainNavigation.map((item) => {
        const isActive =
          item.href === '/'
            ? currentPath === '/'
            : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
        return (
          <a
            href={item.href}
            class:list={[
              'block py-2.5 text-base font-display transition-colors focus-ring',
              isActive
                ? 'text-accent dark:text-accent-dark font-semibold'
                : 'text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark'
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
    <div class="pt-4 border-t border-border dark:border-border-dark mt-3 flex flex-col gap-2">
      <a
        href="/contact"
        class="inline-flex items-center justify-center text-xs font-mono uppercase tracking-wider py-2.5 rounded border border-accent dark:border-accent-dark text-accent dark:text-accent-dark hover:bg-accent hover:text-white dark:hover:bg-accent-dark dark:hover:text-canvas-dark transition-colors font-semibold"
      >
        Get in Touch
      </a>
      <a
        href="/resume/Fuad_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="block py-1.5 text-xs font-mono text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark"
      >
        Download Resume (PDF) &nearr;
      </a>
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-nav-dialog');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!trigger || !panel || !hamburgerIcon || !closeIcon) return;

    function openMenu() {
      panel?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
      trigger?.setAttribute('aria-label', 'Close main menu');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }

    function closeMenu() {
      panel?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.setAttribute('aria-label', 'Open main menu');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    trigger.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        trigger.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        trigger.getAttribute('aria-expanded') === 'true' &&
        !panel.contains(target) &&
        !trigger.contains(target)
      ) {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
