---
interface Props {
  title: string;
  message: string;
  resetText?: string;
  resetId?: string;
  class?: string;
}

const {
  title,
  message,
  resetText = 'Reset filters',
  resetId = 'empty-state-reset-btn',
  class: className = ''
} = Astro.props;
---

<div
  class={`text-center py-12 px-4 rounded-lg border border-dashed border-border bg-surface ${className}`}
  role="status"
  aria-live="polite"
>
  <div class="mx-auto w-10 h-10 rounded-md border border-border bg-alt flex items-center justify-center text-muted mb-3">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
    </svg>
  </div>
  <h3 class="text-base font-heading font-semibold text-heading mb-1">
    {title}
  </h3>
  <p class="text-sm text-muted max-w-sm mx-auto mb-5 font-sans">
    {message}
  </p>
  {resetText && (
    <button
      type="button"
      id={resetId}
      class="btn-primary text-xs py-1.5 px-3.5"
    >
      {resetText}
    </button>
  )}
</div>
