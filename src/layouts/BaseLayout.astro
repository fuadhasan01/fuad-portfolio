---
import SEOHead, { type ArticleData } from '../components/common/SEOHead.astro';
import SiteSidebar from '../components/navigation/SiteSidebar.astro';
import MobileHeader from '../components/navigation/MobileHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  articleData?: ArticleData;
  wide?: boolean;
}

const { title, description, image, article = false, articleData, wide = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SEOHead title={title} description={description} image={image} article={article} articleData={articleData} />
  </head>
  <body class="bg-canvas text-body transition-colors duration-150 antialiased">
    <!-- Skip to main content for keyboard accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 z-50 px-4 py-2 bg-primary text-canvas font-medium rounded-md shadow-md focus-ring"
    >
      Skip to main content
    </a>

    <div class="min-h-screen flex flex-col lg:flex-row">
      <!-- Desktop Persistent Sidebar (>= 1020px) -->
      <SiteSidebar currentPath={currentPath} />

      <!-- Main Column (Mobile Header + Content + Footer) -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Mobile Header (< 1020px) -->
        <MobileHeader currentPath={currentPath} />

        <!-- Main Content Area -->
        <main
          id="main-content"
          class:list={[
            'flex-1 w-full mx-auto px-5 sm:px-8 lg:px-10 py-8 lg:py-12',
            wide ? 'max-w-content-wide' : 'max-w-content'
          ]}
        >
          <slot />
        </main>

        <!-- Compact Footer -->
        <SiteFooter />
      </div>
    </div>
  </body>
</html>
